{
  "name": "@pikku/addon-kysely-node-sqlite",
  "version": "0.12.11",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/addon/kysely-node-sqlite"
  },
  "description": "Kysely driver for Pikku backed by the built-in node:sqlite module",
  "author": "yasser.fadl@gmail.com",
  "license": "MIT",
  "module": "dist/src/index.js",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "tsc": "tsc",
    "ncu": "npx npm-check-updates",
    "build": "pikku all && tsc -b && pikku dist",
    "test": "bash run-tests.sh",
    "test:watch": "bash run-tests.sh --watch",
    "test:coverage": "bash run-tests.sh --coverage",
    "clean": "rm -rf dist tsconfig.tsbuildinfo .pikku",
    "build:compile": "bun run clean && tsc -b",
    "pikku": "pikku all",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": ">=22.10"
  },
  "dependencies": {
    "@pikku/addon-kysely": "^0.13.43",
    "@pikku/addon-kysely-sqlite": "^0.12.19",
    "kysely": "^0.29.6"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.156",
    "zod": "^4"
  },
  "devDependencies": {
    "@pikku/core": "^0.12.156",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^26",
    "tsx": "^4.23.15",
    "zod": "^4"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./package.json": "./package.json",
    "./.pikku/*": "./dist/.pikku/addon/*"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "imports": {
    "#pikku/*.js": "./dist/.pikku/*.js",
    "#pikku/*": "./dist/.pikku/*/index.js"
  }
}
