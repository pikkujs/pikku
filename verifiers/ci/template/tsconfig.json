{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "#pikku/*.js": [
        "./.pikku/*.ts"
      ],
      "#pikku/*": [
        "./.pikku/*/index.ts",
        "./.pikku/*"
      ]
    }
  },
  "include": [
    "packages/functions/src/",
    ".pikku/*"
  ]
}
