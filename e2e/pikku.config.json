{
  "$schema": "https://raw.githubusercontent.com/pikkujs/pikku/refs/heads/main/packages/cli/cli.schema.json",
  "rootDir": ".",
  "tsconfig": "./tsconfig.json",
  "srcDirectories": [
    "src",
    "packages/functions/src",
    "packages/functions/tests"
  ],
  "outDir": ".pikku",
  "rpcMapDeclarationFile": ".pikku/rpc-map.gen.d.ts",
  "httpMapDeclarationFile": ".pikku/http-map.gen.d.ts",
  "packageMappings": {
    ".": "@pikku/e2e",
    "packages/functions": "@pikku/e2e-functions"
  },
  "clientFiles": {
    "fetchFile": ".pikku/pikku-fetch.gen.ts",
    "rpcWiringsFile": ".pikku/pikku-rpc.gen.ts"
  },
  "schema": {
    "supportsImportAttributes": true
  },
  "cli": {
    "entrypoints": {
      "release": [
        {
          "type": "channel",
          "wirePath": "packages/functions/src/wirings/release-cli-channel.gen.ts",
          "path": ".pikku/cli/release-cli-client.gen.ts",
          "name": "release-cli",
          "route": "/cli/release"
        }
      ]
    }
  },
  "scaffold": {
    "pikkuDir": "packages/functions/src/pikku",
    "addonDir": "packages",
    "rpc": {
      "auth": false
    },
    "console": true,
    "scenarios": true,
    "agent": {
      "auth": false
    },
    "workflow": {
      "auth": false
    },
    "webhook": true,
    "userAdmin": true
  },
  "emailTemplatesDir": "emails",
  "environments": {
    "local": {
      "apiUrl": "http://localhost:4077",
      "appUrl": "http://localhost:4077",
      "signInPath": "/api/auth/sign-in/actor"
    }
  },
  "scenarios": {
    "emailDomain": "actors.local",
    "model": "openai/gpt-4.1-mini"
  }
}
