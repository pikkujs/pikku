{
  "name": "@pikku/kysely-node-sqlite",
  "version": "0.12.10",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/services/kysely-node-sqlite"
  },
  "description": "Kysely driver for Pikku backed by the built-in node:sqlite module",
  "author": "yasser.fadl@gmail.com",
  "license": "MIT",
  "module": "dist/src/index.js",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "tsc": "tsc",
    "ncu": "npx npm-check-updates",
    "build": "bun run clean && tsc -b",
    "test": "bash run-tests.sh",
    "test:watch": "bash run-tests.sh --watch",
    "test:coverage": "bash run-tests.sh --coverage",
    "prepublishOnly": "bun run build",
