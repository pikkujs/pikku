{
  "name": "@pikku/react",
  "version": "0.12.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/frontend/react"
  },
  "description": "React bindings for Pikku — provider and hooks for fetch, RPC, agents, workflows and realtime",
  "author": "yasser.fadl@gmail.com",
  "license": "MIT",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./i18n-jsx/jsx-runtime": {
      "import": {
        "types": "./dist/esm/i18n-jsx/jsx-runtime.d.ts",
        "default": "./dist/esm/i18n-jsx/jsx-runtime.js"
      },
      "require": {
        "types": "./dist/cjs/i18n-jsx/jsx-runtime.d.ts",
        "default": "./dist/cjs/i18n-jsx/jsx-runtime.js"
      }
    },
    "./i18n-jsx/jsx-dev-runtime": {
      "import": {
        "types": "./dist/esm/i18n-jsx/jsx-dev-runtime.d.ts",
        "default": "./dist/esm/i18n-jsx/jsx-dev-runtime.js"
      },
      "require": {
        "types": "./dist/cjs/i18n-jsx/jsx-dev-runtime.d.ts",
        "default": "./dist/cjs/i18n-jsx/jsx-dev-runtime.js"
      }
    }
  },
  "scripts": {
    "tsc": "tsc",
    "tsc:tests": "tsc -p tsconfig.test.json",
    "test": "node --test src/*.test.ts",
    "build:esm": "tsc -p tsconfig.test.json && tsc -b && echo '{\"type\": \"module\"}' > dist/esm/package.json",
    "build:cjs": "tsc6 -b tsconfig.cjs.json && echo '{\"type\": \"commonjs\"}' > dist/cjs/package.json",
    "build": "bun run build:esm && bun run build:cjs",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@pikku/fetch": "^0.12.11"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19"
  }
}
