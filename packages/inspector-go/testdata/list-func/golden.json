            }
          },
          {
            "type": "object",
            "properties": {
              "equals": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "not": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/definitions/LeafValue<string>"
                  }
                ]
              },
              "in": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "notIn": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "gt": {
                "type": "string"
              },
              "gte": {
                "type": "string"
              },
              "lt": {
                "type": "string"
              },
              "lte": {
                "type": "string"
              },
              "contains": {
                "type": "string"
              },
              "startsWith": {
                "type": "string"
              },
              "endsWith": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "sensitive",
                  "insensitive"
                ]
              }
            },
            "additionalProperties": false
          }
        ],
        "description": "Leaf predicate on a single field. The operator keywords mirror Prisma's vocabulary; they are reserved and cannot be used as user field names in a Filter's `F` type."
      },
      "LeafValue<boolean>": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          },
          {
            "type": "array",
            "items": {
              "type": "boolean"
            }
          },
          {
            "type": "object",
            "properties": {
              "equals": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "not": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/definitions/LeafValue<boolean>"
                  }
                ]
              },
              "in": {
                "type": "array",
                "items": {
                  "type": "boolean"
                }
              },
              "notIn": {
                "type": "array",
                "items": {
                  "type": "boolean"
                }
              },
              "gt": {
                "type": "boolean"
              },
              "gte": {
                "type": "boolean"
              },
              "lt": {
                "type": "boolean"
              },
              "lte": {
                "type": "boolean"
              },
              "contains": {
                "type": "string"
              },
              "startsWith": {
                "type": "string"
              },
              "endsWith": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "sensitive",
                  "insensitive"
                ]
              }
            },
            "additionalProperties": false
          }
        ],
        "description": "Leaf predicate on a single field. The operator keywords mirror Prisma's vocabulary; they are reserved and cannot be used as user field names in a Filter's `F` type."
      }
    }
  },
