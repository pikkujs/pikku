{
  "name": "@pikku/lambda",
  "version": "0.12.12",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/runtimes/aws-lambda"
  },
  "description": "AWS Lambda runtime for Pikku — HTTP, WebSocket, SQS queue and scheduled handlers",
  "license": "MIT",
  "author": "yasser.fadl@gmail.com",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "tsc": "tsc",
    "ncu": "npx npm-check-updates",
    "build": "bun run clean && tsc -b",
    "release": "npm run build && npm test",
    "test": "bash run-tests.sh",
    "test:watch": "bash run-tests.sh --watch",
    "test:coverage": "bash run-tests.sh --coverage",
    "prepublishOnly": "bun run build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "exports": {
    ".": "./dist/index.js",
    "./http": "./dist/http/index.js",
    "./websocket": "./dist/websocket/index.js",
    "./queue": "./dist/queue/index.js",
    "./scheduled": "./dist/scheduled/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "peerDependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.713.0",
    "@aws-sdk/client-lambda": "^3.713.0",
    "@aws-sdk/client-sqs": "^3.713.0",
    "@pikku/core": "^0.12.144",
    "@types/aws-lambda": "^8.10.161"
  },
  "devDependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1152.0",
    "@aws-sdk/client-lambda": "^3.1152.0",
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@types/aws-lambda": "^8.10.164"
  },
  "engines": {
    "node": ">=24"
  }
}
