# The embedded skill manifest is one generated 500 KB object literal; formatting it
# explodes it into tens of thousands of lines and makes every skill edit unreviewable.
packages/skills/src/skills.gen.ts

# The n8n conversion corpus: 237 workflow records kept minified to one line each, so a
# fixture reads as a single diffable unit and a new one is a single added line. Formatting
# them expands every record to hundreds of lines and makes the corpus unreviewable.
packages/n8n-import/fixtures/
packages/n8n-import/fixtures-ai/

# The API report is generated and compared byte-for-byte by api-report.test.ts, so
# formatting it puts prettier and the generator in a loop neither can win. It also
# pads the summary tables to their widest cell, which turns one changed count into
# a rewrite of all fifty rows — churn in the file the repo already fights over.
packages/core/api-report.md

# The worked-example corpus. Each recipe is several destination FILES concatenated into
# one source file, split on `// ===== FILE: … =====` markers, so it is deliberately not a
# valid module on its own — duplicate imports across sections are the normal shape, and one
# recipe is a fragment prettier cannot even parse. Formatting them also rewrites the exact
# text `pikku examples add` writes into a user's project.
packages/cli/examples/
