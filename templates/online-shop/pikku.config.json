{
  "$schema": "https://raw.githubusercontent.com/pikkujs/pikku/refs/heads/main/packages/cli/cli.schema.json",
  "rootDir": ".",
  "tsconfig": "./tsconfig.json",
  "srcDirectories": ["./src", "./test"],
  "emailTemplatesDir": "./emails",
  "packageMappings": {
    ".": "@pikku/example-online-shop"
  },
  "schema": {
    "supportsImportAttributes": true
  },
  "content": {
    "uploadUrlPrefix": "/upload",
    "assetUrlPrefix": "/content",
    "sizeLimit": "10mb"
  },
  "scaffold": {
    "pikkuDir": "src/scaffold",
    "console": true,
    "rpc": true,
    "agent": true,
    "workflow": true,
    "scenarios": true,
    "virtualUser": true,
    "events": true,
    "webhook": true,
    "analytics": {
      "originLock": false
    }
  },
  "scenarios": {
    "emailDomain": "virtualuser.local"
  },
  "environments": {
    "local": {
      "backends": {
        "api": {
          "signInPath": "/api/auth/sign-in/virtual-user"
        }
      },
      "frontends": {
        "web": "http://localhost:7211"
      }
    },
    "sandbox": {
      "backends": {
        "api": {
          "url": "http://localhost:4000",
          "signInPath": "/api/auth/sign-in/virtual-user"
        }
      }
    },
    "coverage": {
      "backends": {
        "api": {
          "url": "http://localhost:4010",
          "signInPath": "/api/auth/sign-in/virtual-user"
        }
      }
    }
  },
  "allow": {
    "complexWorkflows": true
  },
  "backends": {
    "api": {
      "filter": {},
      "dev": {
        "port": 4011
      }
    }
  }
}
