{
  "name": "@pikku/shadcdn",
  "version": "0.0.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/shadcdn"
  },
  "description": "shadcn/ui components, stories and page blocks for Pikku apps, copied into the app like shadcn itself",
  "author": "yasser.fadl@gmail.com",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ui",
    "lib",
    "blocks"
  ],
  "scripts": {
    "generate": "tsx scripts/generate-registry.ts",
    "tsc": "bun run generate && tsc --noEmit",
    "test": "bun run generate && tsx --test src/registry.test.ts",
    "build": "bun run generate && tsc -b",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/node": "^24.13.3",
    "react": "^19",
    "tsx": "^4",
    "typescript": "^5.9"
  }
}
