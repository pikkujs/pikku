{
  "name": "@pikku/addon-kysely",
  "version": "0.13.47",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/addon/kysely"
  },
  "description": "Kysely-backed Pikku services \u2014 workflow state, secrets, sessions, scopes and audit",
  "author": "yasser.fadl@gmail.com",
  "license": "MIT",
  "module": "dist/src/index.js",
  "main": "dist/src/index.js",
  "bin": {
    "pikku-kysely-pure": "dist/bin/pikku-kysely-pure.js"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "tsc": "tsc",
    "ncu": "npx npm-check-updates",
    "build": "pikku all && tsc -b && pikku dist",
    "test": "bash run-tests.sh",
    "test:watch": "bash run-tests.sh --watch",
    "test:coverage": "bash run-tests.sh --coverage",
    "release": "npm run build && npm test",
    "clean": "rm -rf dist tsconfig.tsbuildinfo .pikku",
    "build:compile": "bun run clean && tsc -b",
    "pikku": "pikku all",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.161"
  },
  "dependencies": {
    "kysely": "^0.29.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@standard-schema/spec": "^1.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "kysely-codegen": "^0.20.0",
    "kysely-postgres-js": "^5.0.1",
    "postgres": "^3.4.9"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./package.json": "./package.json",
    "./.pikku/*": "./dist/.pikku/addon/*"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "imports": {
    "#pikku/*.js": "./dist/.pikku/*.js",
    "#pikku/*": "./dist/.pikku/*/index.js"
  }
}
