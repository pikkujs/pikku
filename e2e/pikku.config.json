{
  "$schema": "https://raw.githubusercontent.com/pikkujs/pikku/refs/heads/main/packages/cli/cli.schema.json",
  "rootDir": ".",
  "tsconfig": "./tsconfig.json",
  "srcDirectories": [
    "src",
    "packages/functions/src",
    "packages/functions/tests"
  ],
  "packageMappings": {
    ".": "@pikku/e2e",
    "packages/functions": "@pikku/e2e-functions"
  },
  "schema": {
    "supportsImportAttributes": true
  },
  "cli": {
    "entrypoints": {
      "release": [
        {
          "type": "channel",
          "wirePath": "packages/functions/src/wirings/release-cli-channel.gen.ts",
          "path": ".pikku/cli/release-cli-client.gen.ts",
          "name": "release-cli",
          "route": "/cli/release"
        }
      ]
    }
  },
  "scaffold": {
    "pikkuDir": "packages/functions/src/pikku",
    "addonDir": "packages",
    "rpc": true,
    "console": true,
    "scenarios": true,
    "agent": true,
    "workflow": true,
    "webhook": true,
    "analytics": {
      "originLock": false
    },
    "featureFlags": true
  },
  "emailTemplatesDir": "emails",
  "environments": {
    "local": {
      "backends": {
        "api": {
          "signInPath": "/api/auth/sign-in/virtual-user"
        }
      },
      "frontends": {
        "web": "http://localhost:4077"
      }
    }
  },
  "models": {
    "chat": "openai/gpt-5.6-luna",
    "reasoning": "openai/gpt-5.6-luna",
    "cheap": "openai/gpt-5.6-luna"
  },
  "scenarios": {
    "emailDomain": "virtualuser.local",
    "model": "openai/gpt-5.6-luna"
  },
  "allow": {
    "complexWorkflows": true
  },
  "frontends": {
    "web": {
      "cwd": "packages/web",
      "dist": "dist-native",
      "kind": "spa",
      "native": {
        "identifier": "dev.pikku.e2e",
        "productName": "Pikku E2E",
        "platforms": ["desktop", "android", "ios"],
        "plugins": []
      }
    }
  },
  "backends": {
    "api": {
      "filter": {},
      "dev": {
        "port": 4077
      }
    }
  }
}
