{
  "name": "@pikku/queue-nats",
  "version": "0.12.7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/addon/queue-nats"
  },
  "description": "NATS JetStream queue, worker and scheduler services for Pikku",
  "author": "yasser.fadl@gmail.com",
  "license": "MIT",
  "module": "dist/src/index.js",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "tsc": "tsc",
    "test": "bash run-tests.sh",
    "test:coverage": "bash run-tests.sh --coverage",
    "ncu": "npx npm-check-updates",
    "build": "bun run clean && pikku all && tsc -b && pikku dist",
    "release": "npm run build && npm test",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "pikku": "pikku all"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.162"
  },
  "dependencies": {
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/nats-core": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./.pikku/*": "./dist/.pikku/addon/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "devDependencies": {
    "@pikku/cli": "workspace:*",
    "@standard-schema/spec": "^1.1.0"
  },
  "imports": {
    "#pikku/*.js": "./dist/.pikku/*.js",
    "#pikku/*": "./dist/.pikku/*/index.js"
  }
}
