{
  "tsconfig": "./tsconfig.json",
  "srcDirectories": ["src"],
  "backends": {
    "all": {
      "filter": {},
      "dev": {
        "port": 4000
      }
    },
    "notifications_no_sms": {
      "filter": {
        "tags": ["notifications"],
        "excludeTags": ["sms"]
      },
      "dev": {
        "port": 4001
      }
    },
    "payments_only": {
      "filter": {
        "tags": ["payments"],
        "excludeNames": ["*Email*"]
      },
      "dev": {
        "port": 4002
      }
    }
  }
}
