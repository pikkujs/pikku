{
  "$schema": "https://raw.githubusercontent.com/pikkujs/pikku/refs/heads/main/packages/cli/cli.schema.json",
  "srcDirectories": ["./src", "./types"],
  "ignoreFiles": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/node_modules/**",
    "**/dist/**",
    "**/runners/crash-reclaim-markers.ts",
    "**/runners/crash-reclaim-worker.ts",
    "**/runners/run-lease-contention.runner.ts",
    "**/tests/fencing-db.assert.ts",
    "**/tests/graph-foreach.assert.ts",
    "**/tests/lease-db.assert.ts",
    "**/tests/planned-steps.assert.ts"
  ],
  "outDir": "./.pikku",
  "tsconfig": "./tsconfig.json",
  "schema": {
    "supportsImportAttributes": true
  },
  "clientFiles": {
    "fetchFile": ".pikku/pikku-fetch.gen.ts",
    "websocketFile": ".pikku/pikku-websocket.gen.ts",
    "rpcWiringsFile": ".pikku/pikku-rpc.gen.ts",
    "queueWiringsFile": ".pikku/pikku-queue.gen.ts",
    "mcpJsonFile": ".pikku/mcp/mcp.gen.json"
  },
  "scaffold": {
    "workflow": true
  },
  "scenarios": {
    "emailDomain": "virtualuser.local"
  },
  "allow": {
    "complexWorkflows": true
  },
  "lint": {
    "enforceContentService": "off"
  }
}
