{
  "services": {
    "inbox": {
      "module": "src/services/inbox.ts",
      "export": "inbox",
      "variants": {
        "dev": { "needs": ["logger"], "provides": ["inbox"] },
        "deploy": { "needs": ["kysely", "logger"], "provides": ["inbox", "inboxMetrics"] }
      }
    },
    "cache": {
      "module": "src/services.ts",
      "export": "cache",
      "variants": { "common": { "needs": ["kysely"], "provides": ["cache"] } }
    }
  }
}
