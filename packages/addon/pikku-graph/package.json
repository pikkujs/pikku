{
  "name": "@pikku/addon-graph",
  "version": "0.12.16",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/addon/pikku-graph"
  },
  "description": "Graph addon for Pikku — built-in graph:* primitives for workflow graphs",
  "type": "module",
  "imports": {
    "#pikku/*.js": "./dist/.pikku/*.js",
    "#pikku/*": "./dist/.pikku/*/index.js"
  },
  "exports": {
    ".": "./dist/.pikku/addon/pikku-bootstrap.gen.js",
    "./.pikku/*": "./dist/.pikku/addon/*",
    "./.pikku/pikku-metadata.gen.json": "./dist/.pikku/addon/pikku-metadata.gen.json",
    "./.pikku/rpc/pikku-rpc-wirings-map.internal.gen.js": {
      "types": "./dist/.pikku/addon/rpc/pikku-rpc-wirings-map.internal.gen.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bash ./build.sh",
    "pikku": "bash ./build.sh pikku",
    "ncu": "npx npm-check-updates",
    "pretest": "bash ./build.sh pikku",
    "test": "tsc --noEmit"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.138",
    "zod": "^4"
  },
  "devDependencies": {
    "@pikku/cli": "^0.12.182",
    "@pikku/core": "*",
    "@standard-schema/spec": "^1.1.0",
    "zod": "^4"
  },
  "dependencies": {
    "dayjs": "^1.11.21"
  },
  "license": "MIT"
}
