{
  "name": "@pikku/verifiers-types",
  "type": "module",
  "private": true,
  "description": "TypeScript type constraint tests for Pikku framework",
  "imports": {
    "#pikku/scenario": "./.pikku/scenarios/pikku-scenario-types.gen.ts",
    "#pikku/*.js": "./.pikku/*.js",
    "#pikku/*": "./.pikku/*/index.js"
  },
  "dependencies": {
    "@pikku/core": "workspace:*",
    "@pikku/templates-function-addon": "workspace:*"
  },
  "devDependencies": {
    "@pikku/cli": "workspace:*",
    "@types/node": "^24",
    "typescript": "^6.0.3",
    "zod": "^4"
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "test": "(pikku || true) && tsc --noEmit",
    "ncu": "npx npm-check-updates",
    "ncu:pikku": "npx npm-check-updates -f '/@pikku/.*/'"
  }
}
