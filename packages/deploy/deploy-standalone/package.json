{
  "name": "@pikku/deploy-standalone",
  "version": "0.12.25",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/deploy/deploy-standalone"
  },
  "description": "Standalone deploy adapter for Pikku \u2014 bundles a project into a node bundle or a compiled bun executable",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "tsc": "tsc --noEmit",
    "test": "node --test --import tsx \"src/**/*.test.ts\""
  },
  "exports": {
    ".": "./dist/index.js",
    "./runtime": "./dist/runtime/index.js",
    "./native": "./dist/tauri/index.js"
  },
  "license": "MIT",
  "dependencies": {
    "@pikku/deploy": "^0.12.14",
    "@pikku/migrator-sql": "^0.12.6"
  }
