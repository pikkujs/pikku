{
  "name": "@pikku/templates-uws",
  "main": "src/start.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -b",
    "tsc": "tsc",
    "ncu": "npx npm-check-updates",
    "ncu:pikku": "npx npm-check-updates -f '/@pikku/.*/'",
    "start": "tsx src/start.ts",
    "dev": "tsx --watch src/start.ts"
  },
  "dependencies": {
    "@pikku/core": "^0.12.148",
    "@pikku/uws": "^0.12.14",
    "@pikku/websocket": "^0.12.6",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^26",
    "@types/ws": "^8",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": "./src/start.ts"
  }
}
