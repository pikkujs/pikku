{
  "name": "@pikku/deploy-azure",
  "version": "0.12.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/deploy/deploy-azure"
  },
  "description": "Azure Functions deploy adapter for Pikku — generates entry points, host.json and the infra manifest",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun run clean && tsc -b",
    "tsc": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "license": "MIT",
  "dependencies": {
    "@pikku/deploy": "^0.12.1"
  }
}
