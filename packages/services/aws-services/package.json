{
  "name": "@pikku/aws-services",
  "version": "0.12.16",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/services/aws-services"
  },
  "description": "AWS services for Pikku — S3 content, Secrets Manager and SQS queues",
  "author": "yasser.fadl@gmail.com",
  "license": "MIT",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "tsc": "tsc",
    "ncu": "npx npm-check-updates",
    "build": "bun run clean && tsc -b",
    "release": "npm run build && npm test",
    "test": "bash run-tests.sh",
    "test:watch": "bash run-tests.sh --watch",
    "test:coverage": "bash run-tests.sh --coverage",
    "prepublishOnly": "bun run build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "exports": {
    ".": "./dist/index.js",
    "./s3": "./dist/s3-content.js",
    "./secrets": "./dist/aws-secrets.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "scripts"
  ],
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.732.0",
    "@aws-sdk/client-secrets-manager": "^3.714.0",
    "@aws-sdk/client-sqs": "^3.732.0",
    "@aws-sdk/cloudfront-signer": "^3.723.0",
    "@aws-sdk/s3-request-presigner": "^3.732.0",
    "@pikku/core": "^0.12.144"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-secrets-manager": "^3.1152.0",
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@aws-sdk/cloudfront-signer": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@types/sinon": "^22.0.0",
    "sinon": "^22.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
