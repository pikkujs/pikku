{
  "name": "@pikku/cli",
  "version": "0.12.126",
  "description": "Pikku CLI — code generation, dev server, migrations and deployment",
  "author": "yasser.fadl@gmail.com",
  "license": "BUSL-1.1",
  "imports": {
    "#pikku/*.js": "./dist/.pikku/*.js",
    "#pikku/*": "./dist/.pikku/*/index.js"
  },
  "bin": {
    "pikku": "dist/bin/pikku.js"
  },
  "type": "module",
  "main": "dist/bin/pikku.js",
  "module": "dist/bin/pikku.js",
  "scripts": {
    "tsc": "tsc && tsc -p tsconfig.type-tests.json",
    "schema": "ts-json-schema-generator -o cli.schema.json --path 'src/utils/pikku-cli-config.ts' --type 'PikkuCLIConfig'",
    "build": "./build.sh",
    "ncu": "npx npm-check-updates -x '/.*glob.*/'",
    "release": "yarn build && npm test",
    "test": "bash run-tests.sh",
    "test:watch": "bash run-tests.sh --watch",
    "test:coverage": "bash run-tests.sh --coverage",
    "prepublishOnly": "yarn build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@electric-sql/pglite": "^0.5.5",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@openapi-contrib/json-schema-to-openapi-schema": "^4.3.4",
    "@pikku/ai-vercel": "^0.12.13",
    "@pikku/better-auth": "^0.12.33",
    "@pikku/bun-server": "^0.12.10",
    "@pikku/code-edit": "^0.12.1",
    "@pikku/deploy": "^0.12.2",
    "@pikku/deploy-cloudflare": "^0.12.13",
    "@pikku/fetch": "^0.12.10",
    "@pikku/inspector": "^0.12.68",
    "@pikku/knowledge": "^0.12.7",
    "@pikku/kysely": "^0.13.23",
    "@pikku/n8n-import": "^0.0.7",
    "@pikku/node-http-server": "^0.12.12",
    "@pikku/openapi-parser": "^0.12.20",
    "@pikku/schedule": "^0.12.7",
    "@pikku/skills": "^0.12.20",
    "@types/cookie": "^1.0.0",
    "@types/json-schema": "^7.0.15",
    "ai": "^7.0.66",
    "chalk": "^6.0.0",
    "chokidar": "^5.0.0",
    "esbuild": "~0.28.2",
    "istanbul-lib-instrument": "^6.0.3",
    "kysely": "^0.29.5",
    "open": "^11.0.1",
    "openapi-types": "^12.1.3",
    "path-to-regexp": "^8.4.2",
    "pg": "^8.23.0",
    "semver": "^7.8.5",
    "tinyglobby": "^0.2.17",
    "ts-json-schema-generator": "2.9.1-next.18",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zod-to-ts": "^2.1.0"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.99",
    "@pikku/playwright": "^0.12.80",
    "@pikku/ws": "^0.12.9",
    "better-auth": "^1.6.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@pikku/core": "^0.12.99",
    "@pikku/playwright": "^0.12.80",
    "@pikku/ws": "^0.12.9",
    "@playwright/test": "^1.50.0",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8",
    "ws": "^8.21.3"
  },
  "files": [
    "dist",
    "console-app",
    "cli.schema.json",
    "surface.json",
    "snippets.json",
    "snippets-meta.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./dist/bin/pikku.js",
    "./server/spawn-dev-server": "./dist/src/server/spawn-dev-server.js",
    "./server/server-ready": "./dist/src/server/server-ready.js",
    "./surface.json": "./surface.json"
  },
  "peerDependenciesMeta": {
    "@pikku/playwright": {
      "optional": true
    },
    "@pikku/ws": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  }
}
