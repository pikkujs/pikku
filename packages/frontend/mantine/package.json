{
  "name": "@pikku/mantine",
  "version": "0.12.9",
  "description": "Mantine components with i18n-tightened types for Pikku — zero runtime added",
  "author": "yasser.fadl@gmail.com",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./core": {
      "import": "./dist/esm/core/index.js",
      "require": "./dist/cjs/core/index.js"
    },
    "./theme": {
      "import": "./dist/esm/theme/index.js",
      "require": "./dist/cjs/theme/index.js"
    }
  },
  "scripts": {
    "tsc": "tsc",
    "test": "tsc -p tsconfig.test-d.json && node --test src/theme/theme-contract.test.ts",
    "build:esm": "tsc -b && echo '{\"type\": \"module\"}' > dist/esm/package.json",
    "build:cjs": "tsc -b tsconfig.cjs.json && echo '{\"type\": \"commonjs\"}' > dist/cjs/package.json",
    "build": "yarn build:esm && yarn build:cjs",
    "prepublishOnly": "yarn build"
  },
  "peerDependencies": {
    "@mantine/core": "^9.2.1",
    "@mantine/hooks": "^9.2.1",
    "@pikku/react": "^0.12.5",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@pikku/react": "workspace:^",
    "@types/react": "^19",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^6.0.3"
  }
}
