{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "module": "Node18",
    "outDir": "dist",
    "target": "esnext",
    "declaration": true,
    "resolveJsonModule": true,
    "paths": {
      "@pikku/cli/addon-support/pages": ["./src/addon-support-pages.ts"]
    }
  },
  "include": [
    "bin/**/*.ts",
    "src/**/*.ts",
    ".pikku/**/*.ts",
    "types/*.ts",
    "types/*.d.ts"
  ],
  "exclude": ["**/*.test.ts", "src/test-preload.ts", "node_modules"],
  "references": [
    {
      "path": "../core/tsconfig.json"
    },
    {
      "path": "../inspector/tsconfig.json"
    },
    {
      "path": "../inspector-go/tsconfig.json"
    }
  ]
}
