{
  "name": "@pikku/addon-typesafe",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/addon/pikku-typesafe"
  },
  "description": "TypeSafe System One addon for Pikku — calibrated judgments and classifications instead of generated text",
  "type": "module",
  "imports": {
    "#pikku/*.js": "./dist/.pikku/*.js",
    "#pikku/*": "./dist/.pikku/*/index.js"
  },
  "exports": {
    ".": "./dist/.pikku/addon/pikku-bootstrap.gen.js",
    "./service": {
      "types": "./dist/src/typesafe.service.d.ts",
      "import": "./dist/src/typesafe.service.js"
    },
    "./.pikku/*": "./dist/.pikku/addon/*",
    "./.pikku/pikku-metadata.gen.json": "./dist/.pikku/addon/pikku-metadata.gen.json",
    "./.pikku/rpc/pikku-rpc-wirings-map.internal.gen.js": {
      "types": "./dist/.pikku/addon/rpc/pikku-rpc-wirings-map.internal.gen.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "./build.sh",
    "pikku": "./build.sh pikku",
    "ncu": "npx npm-check-updates",
    "pretest": "./build.sh pikku",
    "test": "tsc --noEmit"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.108",
    "zod": "^4"
  },
  "devDependencies": {
    "@pikku/cli": "^0.12.146",
    "@pikku/core": "*",
    "@standard-schema/spec": "^1.1.0",
    "zod": "^4"
  },
  "license": "MIT"
}
