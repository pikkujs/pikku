{
  "$schema": "https://raw.githubusercontent.com/pikkujs/pikku/refs/heads/main/packages/cli/cli.schema.json",
  "rootDir": ".",
  "tsconfig": "./tsconfig.json",
  "srcDirectories": [
    "src",
    "packages/functions/src",
    "packages/functions/tests"
  ],
  "outDir": ".pikku",
  "rpcMapDeclarationFile": ".pikku/rpc-map.gen.d.ts",
  "httpMapDeclarationFile": ".pikku/http-map.gen.d.ts",
  "packageMappings": {
    ".": "@pikku/e2e",
    "packages/functions": "@pikku/e2e-functions"
  },
  "console": {
    "functionsPath": "packages/functions/src/wirings/console.functions.gen.ts"
  },
  "clientFiles": {
    "fetchFile": ".pikku/pikku-fetch.gen.ts",
    "rpcWiringsFile": ".pikku/pikku-rpc.gen.ts"
  },
  "schema": {
    "supportsImportAttributes": true
  },
  "cli": {
    "entrypoints": {
      "release": [
        {
          "type": "channel",
          "wirePath": "packages/functions/src/wirings/release-cli-channel.gen.ts",
          "path": ".pikku/cli/release-cli-client.gen.ts",
          "name": "release-cli",
          "route": "/cli/release"
        }
      ]
    }
  },
  "scaffold": {
    "pikkuDir": "packages/functions/src/pikku",
    "addonDir": "packages",
    "rpc": "no-auth",
    "console": "auth",
    "scenarios": "auth",
    "agent": "no-auth",
    "workflow": "no-auth",
    "webhook": true,
    "userAdmin": "auth"
  },
  "emailTemplatesDir": "emails",
  "scenarios": {
    "actors": {
      "shopper": {
        "email": "shopper@actors.local",
        "name": "Shopper",
        "jobTitle": "First-time buyer",
        "personality": "Impatient shopper who abandons slow checkouts"
      },
      "support": {
        "email": "support@actors.local",
        "name": "Support",
        "jobTitle": "Support agent",
        "personality": "Methodical agent who double-checks every order"
      },
      "admin": {
        "email": "admin@actors.local",
        "name": "Admin",
        "jobTitle": "Console administrator",
        "personality": "Careful operator who edits code through the console and always restores it",
        "scopes": ["admin"],
        "roles": ["console-admin"]
      },
      "staff": {
        "email": "staff@actors.local",
        "name": "Staff",
        "jobTitle": "Console admin without a scope role",
        "personality": "Support staff who can open the console but cannot administer scopes",
        "scopes": ["admin"]
      },
      "guest": {
        "email": "guest@actors.local",
        "name": "Guest",
        "jobTitle": "Report reader",
        "personality": "Read-only user who can see reports and nothing else",
        "roles": ["report-viewer"]
      },
      "target": {
        "email": "target@actors.local",
        "name": "Target",
        "jobTitle": "Subject of user administration",
        "personality": "Ordinary user who gets banned, unbanned and reset by other people"
      }
    },
    "environments": {
      "local": {
        "apiUrl": "http://localhost:4077",
        "appUrl": "http://localhost:4077",
        "signInPath": "/api/auth/sign-in/actor"
      }
    }
  }
}
