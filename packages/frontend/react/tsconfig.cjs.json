{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "ignoreDeprecations": "6.0",
    "module": "commonjs",
    "outDir": "dist/cjs",
    "target": "es2015",
    "moduleResolution": "node"
  },
  "exclude": ["**/*.test.ts", "**/*.test-d.ts", "**/*.test-d.tsx", "node_modules", "dist"]
}
