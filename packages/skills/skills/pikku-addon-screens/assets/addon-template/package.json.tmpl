{
  "name": "@acme/addon-hello",
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#pikku/*.js": "./dist/.pikku/*.js",
    "#pikku/*": [
      "./dist/.pikku/*/index.js",
      "./dist/.pikku/*"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./.pikku/*": "./dist/.pikku/addon/*",
    "./screens/*": "./src/screens/*.tsx"
  },
  "files": [
    "dist",
    "src/screens"
  ],
  "scripts": {
    "prebuild": "pikku all",
    "build": "tsc && pikku dist",
    "pikku": "pikku all"
  },
  "peerDependencies": {
    "@pikku/core": "*",
    "react": "*",
    "zod": "^4",
    "@pikku/react": "*"
  },
  "devDependencies": {
    "@pikku/cli": "*",
    "@pikku/core": "*",
    "@pikku/inspector": "*",
    "@types/react": "*",
    "typescript": "^5.7.2",
    "zod": "^4",
    "@types/node": "*"
  }
}
