{
  "name": "@fixture/shop-addon",
  "version": "1.0.0",
  "type": "module",
  "pikku": {
    "uses": [
      "kysely",
      "email"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./.pikku/private/*": null,
    "./.pikku/*": {
      "types": "./dist/.pikku/*",
      "default": "./dist/.pikku/*"
    }
  }
}
