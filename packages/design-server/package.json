{
  "name": "@pikku/design-server",
  "version": "0.12.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/design-server"
  },
  "description": "Pikku design server \u2014 a Vite dev server that renders a project's own components, app widgets and themes for the console's Design page",
  "author": "yasser.fadl@gmail.com",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pikku-design-server": "./bin/start.mjs"
  },
  "exports": {
    ".": "./bin/start.mjs"
  },
  "files": [
    "bin",
    "src",
    "messages",
    "project.inlang/settings.json",
    "index.html",
    "vite.config.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy globalVariable baseLocale --emit-ts-declarations --no-emit-readme --silent",
    "dev": "bun run i18n:compile && node bin/start.mjs",
    "tsc": "bun run i18n:compile && tsc --noEmit",
    "prepublishOnly": "bun run i18n:compile"
  },
  "dependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@pikku/mantine": "^0.12.16",
    "@tanstack/react-query": "^5.66.0",
    "@vitejs/plugin-react": "^4.5.2",
    "lucide-react": "^0.456.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.24.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9"
  }
}
