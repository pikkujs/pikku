{
  "name": "@pikku/code-edit",
  "version": "0.12.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/code-edit"
  },
  "description": "Surgical edits to developer-owned Pikku source — locates a pikku call with the TypeScript AST, then splices the original text so formatting and comments survive",
  "author": "yasser.fadl@gmail.com",
  "license": "MIT",
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n.service.d.ts",
      "import": "./dist/i18n.service.js",
      "default": "./dist/i18n.service.js"
    },
    "./workspace": {
      "types": "./dist/workspace-root.d.ts",
      "import": "./dist/workspace-root.js",
      "default": "./dist/workspace-root.js"
    },
    "./emails": {
      "types": "./dist/emails/index.d.ts",
      "import": "./dist/emails/index.js",
      "default": "./dist/emails/index.js"
    },
    "./files": {
      "types": "./dist/workspace-files.d.ts",
      "import": "./dist/workspace-files.js",
      "default": "./dist/workspace-files.js"
    },
    "./git": {
      "types": "./dist/git.service.d.ts",
      "import": "./dist/git.service.js",
      "default": "./dist/git.service.js"
    }
  },
  "scripts": {
    "tsc": "tsc",
    "build": "tsc -b",
    "release": "bun run build && npm test",
    "test": "bash run-tests.sh",
    "test:coverage": "bash run-tests.sh --coverage",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3"
  },
  "engines": {
    "node": ">=24"
  }
}
