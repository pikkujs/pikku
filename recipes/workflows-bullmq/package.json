{
  "name": "@pikku/templates-workflows-bullmq",
  "type": "module",
  "main": "src/start.ts",
  "private": true,
  "scripts": {
    "tsc": "tsc",
    "ncu": "npx npm-check-updates",
    "ncu:pikku": "npx npm-check-updates -f '/@pikku/.*/'",
    "start": "tsx src/start.ts",
    "dev": "tsx --watch src/start.ts",
    "test:workflows": "npx tsx client/workflow.ts",
    "pikku": "pikku",
    "test": "bash ../functions/run-tests.sh --workflow --ignore-server-ready-check"
  },
  "dependencies": {
    "@pikku/core": "^0.12.152",
    "@pikku/express": "^0.12.18",
    "@pikku/queue-bullmq": "^0.12.12",
    "@pikku/redis": "^0.12.26",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@pikku/cli": "^0.12.205",
    "@pikku/inspector": "^0.12.116",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^26"
  },
  "exports": {
    ".": "./src/start.ts"
  }
}
