  "peerDependencies": {
    "@pikku/core": "^0.12.144"
  },
  "devDependencies": {
    "@pikku/core": "^0.12.144",
    "@types/node": "^26",
    "tsx": "^4.23.15"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ]
