{
  "name": "@pikku/n8n-import",
  "version": "0.0.9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/n8n-import"
  },
  "description": "n8n workflow importer for Pikku — converts n8n exports into Pikku workflow graphs, agents and stub functions",
  "author": "yasser.fadl@gmail.com",
  "license": "MIT",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "tsc": "tsc",
    "build": "bun run clean && tsc -b",
    "test": "node --import tsx --test src/**/*.test.ts",
    "harness": "node --import tsx harness/run.ts",
    "prepublishOnly": "bun run build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@pikku/openapi-to-zod-schema": "^0.12.8",
    "to-json-schema": "^0.2.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/to-json-schema": "^0.2.4"
  }
}
