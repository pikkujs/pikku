{
  "name": "@pikku/console",
  "version": "0.12.68",
  "description": "Pikku Console — the web UI for inspecting and running Pikku projects",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/styles.ts",
    "./shell.css": "./src/styles/shell.css",
    "./adapters/react-router": "./src/adapters/react-router.tsx",
    "./app": "./src/App.tsx",
    "./main": "./src/main.tsx"
  },
  "files": [
    "src",
    ".env",
    "index.html",
    "vite.config.ts",
    "postcss.config.mjs",
    "tsconfig.json",
    "public"
  ],
  "scripts": {
    "ncu": "ncu",
    "dev": "vite --port 7070",
    "build": "yarn generate && vite build",
    "preview": "vite preview",
    "generate": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && cd backend && pikku all",
    "lint": "tsc --noEmit",
    "test": "THEME_CONTRACT_ROOTS=src node --test ../../node_modules/@pikku/mantine/src/theme/theme-contract.test.ts",
    "prepublishOnly": "echo 'Source-only package — no build needed'"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.14",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
