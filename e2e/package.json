{
  "name": "@pikku/e2e",
  "version": "0.0.27",
  "description": "Pikku E2E test harness",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "bin/start.ts",
  "imports": {
    "#pikku/*": "./.pikku/*"
  },
  "scripts": {
    "pretest": "pikku all",
    "start": "tsx bin/start.ts",
    "dev": "tsx --watch bin/start.ts",
    "scenarios": "SCENARIO_ACTOR_SECRET=${SCENARIO_ACTOR_SECRET:-e2e-actor-secret} PIKKU_MOCK_LLM=${PIKKU_MOCK_LLM:-1} FABRIC_API_URL=${FABRIC_API_URL:-http://localhost:4096} pikku scenario run",
    "test": "yarn scenarios local --spawn --no-browser --exclude-tags ai-live,test-fixture",
    "test:agent": "yarn scenarios local --spawn --no-browser --tags agent-protocol",
    "test:addons": "yarn scenarios local --spawn --features addonsFeature",
    "test:console": "yarn scenarios local --spawn --tags console --exclude-tags ai-live,test-fixture",
    "test:ai-live": "PIKKU_MOCK_LLM=0 yarn scenarios local --spawn --tags ai-live",
    "test:scenario-run": "node --import tsx --test tests/cli/*.test.ts",
    "test:unit": "node --import tsx --test bin/*.test.ts packages/functions/tests/scenarios/*.test.ts",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.37",
    "@pikku/addon-console": "workspace:*",
    "@pikku/addon-email-send": "0.1.2",
    "@pikku/addon-gmail": "0.1.2",
    "@pikku/addon-graph": "workspace:*",
    "@pikku/addon-hmac-signer": "workspace:*",
    "@pikku/addon-mailgun": "0.1.2",
    "@pikku/addon-mandrill": "0.1.2",
    "@pikku/ai-vercel": "workspace:*",
    "@pikku/better-auth": "workspace:*",
    "@pikku/core": "workspace:*",
    "@pikku/jose": "workspace:*",
    "@pikku/kysely": "workspace:*",
    "@pikku/kysely-mysql": "workspace:*",
    "@pikku/kysely-postgres": "workspace:*",
    "@pikku/kysely-sqlite": "workspace:*",
    "@pikku/redis": "workspace:*",
    "@pikku/schema-cfworker": "workspace:*",
    "ai": "^6.0.105",
    "better-auth": "^1.6.19",
    "better-sqlite3": "^12.10.0",
    "ioredis": "^5.10.0",
    "kysely": "^0.29.0",
    "kysely-postgres-js": "^3.0.0",
    "mysql2": "^3.18.2",
    "postgres": "^3.4.8",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@pikku/cli": "workspace:*",
    "@pikku/playwright": "workspace:*",
    "@playwright/test": "^1.50.0",
    "@types/better-sqlite3": "^7.0.0",
    "@types/node": "^22",
    "c8": "^10.1.3"
  },
  "exports": {
    ".": "./bin/start.ts"
  }
}
