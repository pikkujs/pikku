    "@codemirror/view": "^6.43.8",
    "@emotion/react": "^11.14.0",
    "@mantine/code-highlight": "^9.5.1",
    "@mantine/core": "^9.5.1",
    "@mantine/dates": "^9.5.1",
    "@mantine/dropzone": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@mantine/spotlight": "^9.5.1",
    "@pikku/assistant-ui": "^0.12.12",
    "@pikku/fetch": "^0.12.10",
    "@pikku/mantine": "^0.12.11",
    "@pikku/react": "^0.12.6",
    "@rjsf/core": "^6.8.0",
    "@rjsf/mantine": "^6.8.0",
    "@rjsf/utils": "^6.8.0",
    "@rjsf/validator-ajv8": "^6.8.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@uiw/react-codemirror": "^4.25.11",
    "allotment": "^1.20.5",
    "better-auth": "^1.6.29",
    "chroma-js": "^3.2.0",
    "clsx": "^2.1.1",
    "cronstrue": "^3.24.0",
    "dayjs": "^1.11.21",
    "elkjs": "^0.12.0",
    "highlight.js": "^11.12.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.31.0",
    "mantine-datatable": "^9.4.0",
    "mermaid": "^11.16.1",
