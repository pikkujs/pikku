{
  "name": "@pikku/templates-remote-rpc-redis",
  "main": "src/start.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -b",
    "tsc": "tsc",
    "ncu": "npx npm-check-updates",
    "ncu:pikku": "npx npm-check-updates -f '/@pikku/.*/'",
    "start": "tsx src/start.ts",
    "dev": "tsx watch src/start.ts | pino-pretty -i time,hostname,pid",
    "test": "bash ../functions/run-tests.sh --url http://localhost:3001 --http",
    "test:http-fetch": "tsx client/test-remote-rpc.ts"
  },
  "dependencies": {
    "@pikku/core": "^0.12.144",
    "@pikku/express": "^0.12.18",
    "@pikku/jose": "^0.12.10",
    "@pikku/redis": "^0.12.24",
    "@pikku/schema-cfworker": "^0.12.9",
    "ioredis": "^6.0.0",
    "pino-pretty": "^13.2.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@pikku/cli": "^0.12.192",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^26"
  },
  "exports": {
    ".": "./src/start.ts"
  }
}
