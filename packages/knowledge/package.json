{
  "name": "@pikku/knowledge",
  "version": "0.12.20",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/knowledge"
  },
  "description": "The Open Knowledge Format app-project profile — read, validate and index a project's knowledge/ notes",
  "author": "yasser.fadl@gmail.com",
  "license": "MIT",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "tsc": "tsc",
    "build": "bun run clean && tsc -b",
    "ncu": "npx npm-check-updates",
    "test": "bash run-tests.sh",
    "test:watch": "bash run-tests.sh --watch",
    "test:coverage": "bash run-tests.sh --coverage",
    "prepublishOnly": "bun run build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  },
  "engines": {
    "node": ">=24"
  }
}
