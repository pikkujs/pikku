{
  "name": "@pikku/deploy-standalone",
  "version": "0.12.28",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/deploy/deploy-standalone"
  },
  "description": "Standalone deploy adapter for Pikku — bundles a project into a node bundle or a compiled bun executable",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun run clean && tsc -b",
    "tsc": "tsc --noEmit",
    "test": "node --test --import tsx \"src/**/*.test.ts\"",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "exports": {
    ".": "./dist/index.js",
    "./runtime": "./dist/runtime/index.js",
    "./native": "./dist/tauri/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "license": "MIT",
  "dependencies": {
    "@pikku/deploy": "^0.12.17",
    "@pikku/migrator-sql": "^0.12.9"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.144"
  }
}
