{
  "name": "@pikku/addon-console",
  "version": "0.12.42",
  "description": "Console addon for Pikku — functions powering the Pikku Console UI",
  "type": "module",
  "imports": {
    "#pikku/*.js": "./dist/.pikku/*.js",
    "#pikku/*": "./dist/.pikku/*/index.js"
  },
  "exports": {
    ".": "./dist/.pikku/pikku-bootstrap.gen.js",
    "./.pikku/*": "./dist/.pikku/*",
    "./.pikku/pikku-metadata.gen.json": "./dist/.pikku/pikku-metadata.gen.json",
    "./.pikku/rpc/pikku-rpc-wirings-map.internal.gen.js": {
      "types": "./dist/.pikku/rpc/pikku-rpc-wirings-map.internal.gen.d.ts"
    },
    "./services": {
      "types": "./dist/src/services/wiring.service.d.ts",
      "import": "./dist/src/services/wiring.service.js",
      "default": "./dist/src/services/wiring.service.js"
    },
    "./channels": {
      "types": "./dist/src/channels.d.ts",
      "import": "./dist/src/channels.js",
      "default": "./dist/src/channels.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pikku all && tsc && (cp .pikku/rpc/*.d.ts dist/.pikku/rpc/ 2>/dev/null || true) && (cp .pikku/agent/*.d.ts dist/.pikku/agent/ 2>/dev/null || true) && (cp .pikku/workflow/*.d.ts dist/.pikku/workflow/ 2>/dev/null || true) && (mkdir -p dist/.pikku/function && cp .pikku/function/*-verbose.gen.json dist/.pikku/function/ 2>/dev/null || true) && (mkdir -p dist/types && cp types/*.d.ts dist/types/)",
    "pikku": "pikku all",
    "pretest": "pikku all",
    "test": "tsc --noEmit",
    "test:coverage": "bash run-tests.sh --coverage"
  },
  "peerDependencies": {
    "@pikku/better-auth": "^0.12.25",
    "@pikku/core": "^0.12.84"
  },
  "peerDependenciesMeta": {
    "@pikku/better-auth": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pikku/better-auth": "^0.12.25",
    "@pikku/cli": "^0.12.105",
    "@pikku/core": "^0.12.84",
    "oauth2-mock-server": "^9.1.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@pikku/knowledge": "^0.12.5",
    "json-schema": "^0.4.0",
    "open": "^11.0.1"
  },
  "license": "MIT"
}
