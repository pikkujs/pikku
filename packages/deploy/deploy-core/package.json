{
  "name": "@pikku/deploy",
  "version": "0.12.16",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/deploy/deploy-core"
  },
  "description": "Shared deploy contract for Pikku — the deployment manifest types, the provider adapter interface, and the helpers every provider adapter needs",
  "type": "module",
  "main": "dist/index.js",
