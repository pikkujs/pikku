{
  "$schema": "https://raw.githubusercontent.com/pikkujs/pikku/refs/heads/main/packages/cli/cli.schema.json",
  "srcDirectories": ["./src", "./types"],
  "ignoreFiles": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/node_modules/**",
    "**/dist/**",
    "**/analytics-meta.assert.ts"
  ],
  "outDir": "./.pikku",
  "tsconfig": "./tsconfig.json",
  "scaffold": {
    "analytics": { "originLock": false },
    "pikkuDir": "pikku"
  }
}
