{
  "name": "@pikku/templates-ws-server",
  "type": "module",
  "main": "src/start.ts",
  "private": true,
  "scripts": {
    "build": "tsc -b",
    "tsc": "tsc",
    "ncu": "npx npm-check-updates",
    "ncu:pikku": "npx npm-check-updates -f '/@pikku/.*/'",
    "start": "tsx src/start.ts",
    "dev": "tsx --watch src/start.ts",
    "test": "bash ../functions/run-tests.sh --websocket"
  },
  "dependencies": {
    "@pikku/core": "^0.12.84",
    "@pikku/ws": "^0.12.7",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/ws": "^8"
  },
  "exports": {
    ".": "./src/start.ts"
  },
  "imports": {
    "#pikku/*.js": "../functions/.pikku/*.ts",
    "#pikku/*": "../functions/.pikku/*/index.ts"
  }
}
