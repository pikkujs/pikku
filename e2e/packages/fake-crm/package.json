{
  "name": "@pikku/addon-fake-crm",
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#pikku/*.js": "./.pikku/*.ts",
    "#pikku/*": "./.pikku/*/index.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./.pikku/*": "./.pikku/addon/*"
  },
  "files": [
    "dist",
    ".pikku"
  ],
  "scripts": {
    "prebuild": "pikku all",
    "build": "tsc && node -e \"require('fs').cpSync('.pikku','dist/.pikku',{recursive:true})\"",
    "pikku": "pikku all"
  },
  "peerDependencies": {
    "@pikku/core": "*",
    "zod": "^4"
  },
  "devDependencies": {
    "@pikku/cli": "*",
    "@pikku/core": "*",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^22",
    "zod": "^4"
  },
  "private": true
}
