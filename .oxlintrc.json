{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxlint-config/refs/heads/main/schema.json",
  "ignorePatterns": [
    "packages/cli/examples/**",
    "packages/inspector-go/testdata/**",
    "inspector-parity/fixtures/**"
  ],
  "rules": {
    "no-unused-vars": "off",
    "no-empty-pattern": "off",
    "no-var": "warn",
    "no-accumulating-spread": "warn",
    "node/no-process-env": "warn",
    "import/no-cycle": "warn",
    "typescript/consistent-type-imports": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/prefer-optional-chain": "warn",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/prefer-includes": "error",
    "unicorn/prefer-optional-catch-binding": "error",
    "unicorn/throw-new-error": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "package": "node:test",
            "name": ["describe", "it", "test", "suite", "skip", "todo", "only"]
          }
        ]
      }
    ]
  },
  "options": {
    "typeAware": true
  },
  "overrides": [
    {
      "files": ["packages/addon/pikku-changes-cli/src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:child_process",
                "importNames": ["spawnSync", "execSync", "execFileSync"],
                "message": "Run tools asynchronously with an explicit cwd and an absolute pinned binary (runCli), so a run can be stopped and a gate never blocks the engine."
              },
              {
                "name": "child_process",
                "importNames": ["spawnSync", "execSync", "execFileSync"],
                "message": "Run tools asynchronously with an explicit cwd and an absolute pinned binary (runCli), so a run can be stopped and a gate never blocks the engine."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/addon/pikku-changes-cli/src/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
