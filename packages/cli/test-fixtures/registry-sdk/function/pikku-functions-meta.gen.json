      "properties": {
        "name": { "type": "string" },
        "range": { "type": "string" }
      },
      "required": ["name", "range"]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "integrity": { "type": "string" },
        "url": { "type": "string" }
      },
      "required": ["version", "integrity", "url"]
    }
  }
}
