{
  "name": "@pikku/e2e",
  "version": "0.0.27",
  "description": "Pikku E2E test harness",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "bin/start.ts",
  "imports": {
    "#pikku/scenario": "./.pikku/scenarios/pikku-scenario-types.gen.ts",
    "#pikku/*.js": "./.pikku/*.ts",
    "#pikku/*": "./.pikku/*/index.ts"
  },
  "scripts": {
    "pretest": "pikku all",
    "start": "tsx bin/start.ts",
    "dev": "tsx --watch bin/start.ts",
    "scenarios": "SCENARIO_ACTOR_SECRET=${SCENARIO_ACTOR_SECRET:-e2e-actor-secret} PIKKU_MOCK_LLM=${PIKKU_MOCK_LLM:-1} FABRIC_API_URL=${FABRIC_API_URL:-http://localhost:4096} pikku scenario run",
    "test": "yarn scenarios local --spawn --exclude-tags ai-live,test-fixture,console",
    "test:agent": "yarn scenarios local --spawn --tags agent-protocol",
    "test:addons": "yarn scenarios local --spawn --run browser --features addonsFeature",
    "test:console": "yarn scenarios local --spawn --run browser --tags console --exclude-tags ai-live,test-fixture",
    "test:ai-live": "PIKKU_MOCK_LLM=0 yarn scenarios local --spawn --run browser --tags ai-live",
    "test:unit": "node --import tsx --test bin/*.test.ts packages/functions/tests/scenarios/*.test.ts",
    "tsc": "tsc --noEmit",
    "test:cli": "node --import tsx --test tests/cli/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.42",
    "@pikku/addon-admin": "workspace:*",
    "@pikku/addon-console": "workspace:*",
    "@pikku/addon-email-send": "0.1.2",
    "@pikku/addon-gmail": "0.1.2",
    "@pikku/addon-graph": "workspace:*",
    "@pikku/addon-hmac-signer": "workspace:*",
    "@pikku/addon-mandrill": "0.1.2",
    "@pikku/ai-deepinfra": "workspace:*",
    "@pikku/ai-vercel": "workspace:*",
    "@pikku/better-auth": "workspace:*",
    "@pikku/core": "workspace:*",
    "@pikku/jose": "workspace:*",
    "@pikku/kysely": "workspace:*",
    "@pikku/kysely-mysql": "workspace:*",
    "@pikku/kysely-postgres": "workspace:*",
    "@pikku/kysely-sqlite": "workspace:*",
    "@pikku/redis": "workspace:*",
    "@pikku/schema-cfworker": "workspace:*",
    "@pikku/websocket": "workspace:*",
    "ai": "^7.0.66",
    "better-auth": "^1.6.29",
    "better-sqlite3": "^13.0.3",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.5",
    "kysely-postgres-js": "^3.0.0",
    "mysql2": "^3.23.3",
    "postgres": "^3.4.9",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@pikku/cli": "workspace:*",
    "@pikku/playwright": "workspace:*",
    "@pikku/ws": "workspace:*",
    "@playwright/test": "^1.50.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "@types/ws": "^8.18.1",
    "c8": "^12.0.0",
    "ws": "^8.21.3"
  },
  "exports": {
    ".": "./bin/start.ts",
    "./.pikku/*.js": "./.pikku/*.ts",
    "./.pikku/*": "./.pikku/*"
  }
}
