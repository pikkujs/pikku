{
  "$schema": "https://raw.githubusercontent.com/pikkujs/pikku/refs/heads/main/packages/cli/cli.schema.json",
  "srcDirectories": ["./src", "./types"],
  "ignoreFiles": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/node_modules/**",
    "**/dist/**",
    "**/tests/run.assert.ts"
  ],
  "outDir": "./.pikku",
  "tsconfig": "./tsconfig.json",
  "scaffold": {
    "virtualUser": true
  },
  "scenarios": {
    "emailDomain": "virtualuser.invalid"
  }
}
