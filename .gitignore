packages/console/src/paraglide/

my-app
.pikku
.deploy
.tmp-pii-gate-*
console-app
cli.schema.json
packages/cli/surface.json
packages/cli/snippets.json
packages/cli/snippets-meta.json
.playwright-mcp

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
.coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test

# parcel-bundler cache (https://parceljs.org/)
.cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and *not* Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port


# Wrangler local dev cache
.wrangler/

# Claude Code worktrees
.claude/worktrees/
.claude/scheduled_tasks.lock

# Bun lockfile — repo is yarn-based; bun is only used to run `bun test` against
# the yarn-installed node_modules, so its lockfile is not tracked.
bun.lock

# Bun build cache
*.bun-build
packages/cli/release/

# better-auth dev sqlite artifacts from verifier runs
**/.better-auth*.sqlite
**/.better-auth*.sqlite-shm
**/.better-auth*.sqlite-wal

# addon-registry verifier install artifacts (shadcn copy + provenance)
verifiers/addon-registry/consumer/addons/
verifiers/addon-registry/consumer/pikku-addons.json
.pikku-shake/

# db-schema verifier: the consumer's migrations and database are the output
# under test — run.mjs deletes and regenerates them, so committing them would
# test the commit rather than the generator. The addon's own db/ is source.
verifiers/db-schema/db/
verifiers/db-schema/.pikku-runtime/
.pikku-runtime/

# The workflow verifier's runtime migration is written by `pikku db generate`
# at the start of every db-backed run, against whatever postgres the run points
# at. Committing it would freeze a copy that nothing reads.
verifiers/workflows/db/

# This repo's OWN OKF knowledge bundle: untracked on purpose. It holds commercial
# strategy, open security findings and memories from unrelated repos, and
# pikkujs/pikku is public.
#
# Anchored to the root with a leading slash. Unanchored, it matched every
# directory named `knowledge` at any depth — which silently swallowed the
# `@pikku/knowledge` package, the console's knowledge components, and the e2e
# harness's own bundle, all of which are source and must be committed.
/knowledge/

# The fullstack verifier ships a hand-written frontend rather than a built one,
# so this browser script is source despite the *.js rule above.
!verifiers/fullstack/web/app.js
