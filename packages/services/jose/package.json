{
  "name": "@pikku/jose",
  "version": "0.12.9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/services/jose"
  },
  "description": "JWT service for Pikku, backed by jose",
