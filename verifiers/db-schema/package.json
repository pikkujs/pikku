{
  "name": "@pikku/verifiers-db-schema",
  "type": "module",
  "private": true,
  "description": "Drives `pikku db generate/migrate/check/baseline` end to end against a real Better Auth config with schema-adding plugins and a real addon that ships a table",
  "imports": {
    "#pikku": "./.pikku/pikku-types.gen.ts",
    "#pikku/*": "./.pikku/*"
  },
  "dependencies": {
    "@pikku/better-auth": "workspace:*",
    "@pikku/core": "workspace:*",
    "@pikku/kysely": "workspace:*",
    "@pikku/schema-cfworker": "workspace:*",
    "better-auth": "^1.6.29",
    "better-sqlite3": "^12.11.1",
    "kysely": "^0.29.5",
    "kysely-postgres-js": "^3.0.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@pikku/cli": "workspace:*",
    "@pikku/verifier-db-remote-addon": "link:./remote-addon",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "zod": "^4"
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "test": "node run.mjs",
    "test:db": "node run.mjs --postgres"
  }
}
