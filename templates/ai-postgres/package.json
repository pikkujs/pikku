{
  "name": "@pikku/templates-ai-postgres",
  "type": "module",
  "main": "src/start.ts",
  "private": true,
  "scripts": {
    "build": "tsc -b",
    "tsc": "tsc",
    "ncu": "npx npm-check-updates",
    "ncu:pikku": "npx npm-check-updates -f '/@pikku/.*/'",
    "start": "tsx src/start.ts",
    "dev": "tsx --watch src/start.ts",
    "migrate": "pikku db generate && pikku db migrate",
    "test": "npm run migrate && bash ../functions/run-tests.sh --agent"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/openai": "^4.0.96",
    "@pikku/ai-vercel": "^0.12.16",
    "@pikku/core": "^0.12.144",
    "@pikku/express": "^0.12.18",
    "@pikku/kysely-postgres": "^0.12.28",
    "@pikku/schema-cfworker": "^0.12.9",
    "kysely": "^0.29.6",
    "kysely-postgres-js": "^5.0.1",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pikku/cli": "^0.12.192",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^26"
  },
  "exports": {
    ".": "./src/start.ts"
  }
}
