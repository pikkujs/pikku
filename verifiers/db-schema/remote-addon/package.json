{
  "name": "@pikku/verifier-db-remote-addon",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "An addon that ships a table and is consumed remotely. Its schema is published exactly like a local addon's \u2014 the consumer must still leave it alone, because it belongs to the host's database.",
  "imports": {
    "#pikku/*.js": "./.pikku/*.ts",
    "#pikku/*": "./.pikku/*/index.ts"
  },
  "exports": {
    "./types": {
      "types": "./types/application-types.d.ts"
    },
    "./.pikku/*": "./.pikku/addon/*",
    "./.pikku/pikku-metadata.gen.json": "./.pikku/addon/pikku-metadata.gen.json",
    "./.pikku/db/pikku-db-meta.gen.json": "./.pikku/addon/db/pikku-db-meta.gen.json",
    "./.pikku/rpc/pikku-rpc-wirings-map.remote.gen.js": {
      "types": "./.pikku/addon/rpc/pikku-rpc-wirings-map.remote.gen.d.ts"
    }
  },
  "files": [
    "src",
    "types",
    "db",
    ".pikku"
  ],
  "scripts": {
    "prebuild": "pikku all && pikku db export",
    "pikku": "pikku all && pikku db export"
  },
  "peerDependencies": {
    "@pikku/core": "*",
    "kysely": "^0.29.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@pikku/cli": "*",
    "@pikku/core": "*",
    "kysely": "^0.29.5",
    "typescript": "^6.0.3",
    "zod": "^4"
  }
}
