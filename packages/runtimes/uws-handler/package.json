{
  "name": "@pikku/uws-handler",
  "version": "0.12.10",
  "description": "uWebSockets.js HTTP and WebSocket handlers for Pikku — bring your own uWS app",
  "license": "MIT",
  "author": "yasser.fadl@gmail.com",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "tsc": "tsc",
    "ncu": "npx npm-check-updates",
    "build": "tsc -b",
