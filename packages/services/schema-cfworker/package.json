{
  "name": "@pikku/schema-cfworker",
  "version": "1.0.0",
  "description": "JSON schema validation for Pikku, backed by @cfworker/json-schema (Workers-compatible)",
  "license": "MIT",
  "author": "yasser.fadl@gmail.com",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "tsc": "tsc",
    "ncu": "npx npm-check-updates",
