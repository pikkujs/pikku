{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "ignoreDeprecations": "6.0",
    "module": "commonjs",
    "outDir": "dist/cjs",
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.cjs.tsbuildinfo",
    "target": "es2015",
    "moduleResolution": "node"
  },
  "exclude": ["**/*.test.tsx", "node_modules", "dist"]
}
