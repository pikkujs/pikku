{
  "name": "@pikku/core",
  "version": "0.12.83",
  "description": "The Pikku runtime — functions, wirings, services, middleware and types",
  "author": "yasser.fadl@gmail.com",
  "license": "MIT",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "tsc": "tsc && tsc -p tsconfig.type-tests.json",
    "build": "tsc -b",
    "ncu": "npx npm-check-updates",
    "release": "npm run build && npm test",
    "test": "bash run-tests.sh",
    "test:watch": "bash run-tests.sh --watch",
    "test:coverage": "bash run-tests.sh --coverage",
    "prepublishOnly": "yarn build",
    "api-report": "tsx scripts/generate-api-report.mts"
  },
  "sideEffects": [
    "./dist/errors/errors.js",
    "./dist/wirings/rpc/rpc-runner.js",
    "./dist/wirings/rpc/remote-addon-auth.js",
    "./dist/wirings/workflow/workflow-approval-policy.js",
    "./dist/wirings/workflow/workflow-errors.js",
    "./dist/wirings/workflow/workflow-run-ownership.js",
    "./dist/wirings/workflow/pikku-scenario-service.js"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./middleware": "./dist/middleware/index.js",
    "./function": "./dist/function/index.js",
    "./channel": "./dist/wirings/channel/index.js",
    "./workflow": "./dist/wirings/workflow/index.js",
    "./scenario": "./dist/wirings/workflow/pikku-scenario-service.js",
    "./workflow/timeline": "./dist/wirings/workflow/run-timeline.js",
    "./workflow/types": "./dist/wirings/workflow/workflow.types.js",
    "./actor-flow": "./dist/wirings/actor-flow/index.js",
    "./virtual-user": "./dist/wirings/virtual-user/index.js",
    "./channel/local": "./dist/wirings/channel/local/index.js",
    "./channel/serverless": "./dist/wirings/channel/serverless/index.js",
    "./http": "./dist/wirings/http/index.js",
    "./remote": "./dist/remote.js",
    "./queue": "./dist/wirings/queue/index.js",
    "./scheduler": "./dist/wirings/scheduler/index.js",
    "./trigger": "./dist/wirings/trigger/index.js",
    "./rpc": "./dist/wirings/rpc/index.js",
    "./safe-fetch": "./dist/utils/safe-fetch.js",
    "./node-host-resolver": "./dist/utils/node-host-resolver.js",
    "./mcp": "./dist/wirings/mcp/index.js",
    "./ai-agent": "./dist/wirings/ai-agent/index.js",
    "./ai-scorer": "./dist/wirings/ai-scorer/index.js",
    "./gateway": "./dist/wirings/gateway/index.js",
    "./cli": "./dist/wirings/cli/index.js",
    "./cli/command-parser": "./dist/wirings/cli/command-parser.js",
    "./cli/channel": "./dist/wirings/cli/channel/index.js",
    "./node": "./dist/wirings/node/index.js",
    "./credential": "./dist/wirings/credential/index.js",
    "./scope": "./dist/wirings/scope/index.js",
    "./role": "./dist/wirings/role/index.js",
    "./persona": "./dist/wirings/persona/index.js",
    "./secret": "./dist/wirings/secret/index.js",
    "./variable": "./dist/wirings/variable/index.js",
    "./oauth2": "./dist/wirings/oauth2/index.js",
    "./errors": "./dist/errors/index.js",
    "./services": "./dist/services/index.js",
    "./services/local-meta": "./dist/services/meta-service.js",
    "./services/v8-coverage": "./dist/services/v8-coverage-service.js",
    "./services/istanbul-coverage": "./dist/services/istanbul-coverage-service.js",
    "./services/local-content": "./dist/services/local-content.js",
    "./services/local-content-request-handler": "./dist/services/local-content-request-handler.js",
    "./services/temporary-file-service": "./dist/services/temporary-file-service.js",
    "./crypto-utils": "./dist/crypto-utils.js",
    "./hmac": "./dist/utils/hmac.js",
    "./ecosystem": "./dist/ecosystem.js",
    "./ecosystem/*": "./dist/ecosystem/*.js",
    "./schema": "./dist/schema.js",
    "./testing": "./dist/testing/index.js",
    "./dev": "./dist/dev/hot-reload.js"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/json-schema": "^7.0.15",
    "cookie": "^1.1.1",
    "json-schema": "^0.4.0",
    "path-to-regexp": "^8.3.0",
    "picoquery": "^2.5.0"
  },
  "devDependencies": {
    "@ag-ui/core": "0.0.57",
    "@types/node": "^24.11.0",
    "esbuild": "~0.27.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
