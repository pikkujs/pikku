{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pikku Studio",
  "version": "0.0.0",
  "identifier": "dev.pikku.studio",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["pikku"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
