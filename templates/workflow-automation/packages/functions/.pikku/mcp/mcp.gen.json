{
  "tools": [
    {
      "name": "listRunsTool",
      "description": "List recent flow runs, optionally filtered by flow or status — use this to answer \"did it run\" and \"why did it fail\"",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "flowId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "limit": {
            "type": "number"
          }
        },
        "additionalProperties": false,
        "definitions": {}
      },
      "returns": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "array",
        "items": {
          "$ref": "#/definitions/MCPToolMessage"
        },
        "definitions": {
          "MCPToolMessage": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "text"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "image"
                  },
                  "data": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "data"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      }
    },
    {
      "name": "cancelRunTool",
      "description": "Cancel a queued or in-flight run",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "runId"
        ],
        "additionalProperties": false,
        "definitions": {}
      },
      "returns": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "array",
        "items": {
          "$ref": "#/definitions/MCPToolMessage"
        },
        "definitions": {
          "MCPToolMessage": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "text"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "image"
                  },
                  "data": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "data"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      }
    }
  ],
  "resources": [],
  "prompts": []
}