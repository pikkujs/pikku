{
  "name": "@pikku/verifiers-tracing",
  "type": "module",
  "private": true,
  "imports": {
    "#pikku/*.js": "./.pikku/*.ts",
    "#pikku/*": "./.pikku/*/index.ts"
  },
  "dependencies": {
    "@pikku/core": "workspace:*",
    "@pikku/jose": "workspace:*",
    "@pikku/node-http-server": "workspace:*",
    "@pikku/queue-bullmq": "workspace:*",
    "@pikku/queue-pg-boss": "workspace:*",
    "@pikku/schedule": "workspace:*",
    "@pikku/schema-cfworker": "workspace:*",
    "zod": "^4"
  },
  "devDependencies": {
    "@pikku/cli": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^26",
    "tsx": "^4.23.15"
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "pikku": "pikku",
    "test": "pikku && tsc --noEmit && node --import tsx --test src/tracing.assert.ts",
    "test:distributed": "pikku && tsc --noEmit && node --import tsx --test src/distributed/distributed.assert.ts",
    "test:queue-identity": "npx tsx src/queue-identity.runner.ts"
  }
}
