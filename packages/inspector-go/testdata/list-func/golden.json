{
  "ListItemsInput": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/definitions/ListInput<ListItemsFilter,ListItemsSortColumn>",
    "definitions": {
      "ListInput<ListItemsFilter,ListItemsSortColumn>": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "description": "Opaque cursor from the previous page's `nextCursor`."
          },
          "limit": {
            "type": "number",
            "description": "Page size. Server may cap."
          },
          "sort": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "column": {
                  "$ref": "#/definitions/ListItemsSortColumn"
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "asc",
                    "desc"
                  ]
                }
              },
              "required": [
                "column",
                "direction"
              ],
              "additionalProperties": false
            },
            "description": "Ordered sort criteria — first entry is primary."
          },
          "filter": {
            "$ref": "#/definitions/Filter<ListItemsFilter>"
          },
          "search": {
            "type": "string",
            "description": "Unstructured text search across server-configured fields."
          }
        },
        "additionalProperties": false,
        "description": "A list function is an ordinary `pikkuFunc` whose input and output adopt these shapes. They are purely structural — no runtime behaviour attaches to them — and exist so MCP tools, agents, RPC clients and widget libraries all reason about cursor, filter, sort and search the same way."
      },
      "ListItemsSortColumn": {
        "type": "string",
        "enum": [
          "createdAt",
          "label"
        ]
      },
      "Filter<ListItemsFilter>": {
        "anyOf": [
          {
            "$ref": "#/definitions/LeafFilter<ListItemsFilter>"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/definitions/Filter<ListItemsFilter>"
            }
          },
          {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/Filter<ListItemsFilter>"
            }
          }
        ],
        "description": "Recursive filter tree: an array is an AND of its children; an object is an OR of its children, keyed by arbitrary unique labels that are ignored at evaluation time; a single-key object is a leaf predicate."
      },
      "LeafFilter<ListItemsFilter>": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "category": {
                "$ref": "#/definitions/LeafValue<string>"
              }
            },
            "required": [
              "category"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "inStock": {
                "$ref": "#/definitions/LeafValue<boolean>"
              }
            },
            "required": [
              "inStock"
            ],
            "additionalProperties": false
          }
        ],
        "description": "A single-key object keyed by a field of F. Single-key so the runtime discriminator is unambiguous — multi-key objects are OR groups."
      },
