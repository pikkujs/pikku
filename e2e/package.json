{
  "name": "@pikku/e2e",
  "version": "0.0.27",
  "description": "Pikku E2E test harness",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "bin/start.ts",
  "imports": {
    "#pikku/scenario": "./.pikku/scenarios/pikku-scenario-types.gen.ts",
    "#pikku/*.js": "./.pikku/*.ts",
    "#pikku/*": "./.pikku/*/index.ts"
  },
  "scripts": {
    "pretest": "pikku all",
    "start": "tsx bin/start.ts",
    "dev": "tsx --watch bin/start.ts",
    "scenarios": "PIKKU_MOCK_LLM=${PIKKU_MOCK_LLM:-1} PIKKUSTUDIO_API_URL=${PIKKUSTUDIO_API_URL:-http://localhost:4096} pikku scenario run",
    "test": "bun run scenarios local --spawn --exclude-tags ai-live,test-fixture,console,browser",
    "test:agent": "bun run scenarios local --spawn --tags agent-protocol",
    "test:web": "bun --cwd packages/web run build && bun run scenarios local --spawn --run browser --features webAppFeature",
    "test:ai-live": "PIKKU_MOCK_LLM=0 bun run scenarios local --spawn --run browser --tags ai-live",
    "test:unit": "node --import tsx --test bin/*.test.ts packages/functions/tests/scenarios/*.test.ts",
    "tsc": "tsc --noEmit",
    "test:cli": "node --import tsx --test tests/cli/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.95",
    "@pikku/addon-admin": "workspace:*",
    "@pikku/addon-console": "workspace:*",
    "@pikku/addon-email-send": "0.1.2",
    "@pikku/addon-emails": "workspace:*",
    "@pikku/addon-fake-crm": "workspace:*",
    "@pikku/addon-gmail": "0.1.2",
    "@pikku/addon-graph": "workspace:*",
    "@pikku/addon-hmac-signer": "workspace:*",
    "@pikku/addon-mandrill": "0.1.2",
    "@pikku/addon-oauth-api": "workspace:*",
    "@pikku/addon-todos": "workspace:*",
    "@pikku/ai-deepinfra": "workspace:*",
    "@pikku/ai-vercel": "workspace:*",
    "@pikku/better-auth": "workspace:*",
    "@pikku/core": "workspace:*",
    "@pikku/e2e-functions": "workspace:*",
    "@pikku/fetch": "workspace:*",
    "@pikku/jose": "workspace:*",
    "@pikku/kysely": "workspace:*",
    "@pikku/kysely-bun-sqlite": "workspace:*",
    "@pikku/kysely-mysql": "workspace:*",
    "@pikku/kysely-postgres": "workspace:*",
    "@pikku/kysely-sqlite": "workspace:*",
    "@pikku/redis": "workspace:*",
    "@pikku/schema-cfworker": "workspace:*",
    "@pikku/websocket": "workspace:*",
    "ai": "^7.0.142",
    "better-auth": "^1.7.10",
    "better-sqlite3": "^13.0.3",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.6",
    "kysely-postgres-js": "^5.0.1",
    "mysql2": "^3.24.6",
    "postgres": "^3.4.9",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.70",
    "@modelcontextprotocol/client": "2.3.1",
    "@pikku/cli": "workspace:*",
    "@pikku/playwright": "workspace:*",
    "@pikku/ws": "workspace:*",
    "@playwright/test": "^1.50.0",
    "@standard-schema/spec": "^1.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^25.9.9",
    "@types/ws": "^8.18.2",
    "c8": "^12.0.0",
    "ws": "^8.22.0"
  },
  "exports": {
    ".": "./bin/start.ts",
    "./.pikku/*.js": "./.pikku/*.ts",
    "./.pikku/*": "./.pikku/*"
  }
}
