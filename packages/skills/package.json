{
  "name": "@pikku/skills",
  "version": "0.12.27",
  "description": "The Pikku agent skills — the instruction set coding agents read to build, wire and deploy Pikku projects",
  "author": "yasser.fadl@gmail.com",
  "license": "MIT",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
