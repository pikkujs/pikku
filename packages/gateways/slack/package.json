{
  "name": "@pikku/gateway-slack",
  "version": "0.12.10",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/gateways/slack"
  },
  "description": "Slack gateway for Pikku — Events API bridge, OAuth, slash commands and message formatting",
  "author": "yasser.fadl@gmail.com",
  "license": "MIT",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "tsc": "tsc",
    "ncu": "npx npm-check-updates",
    "build": "bun run clean && tsc -b",
    "test": "node --import tsx --test src/**/*.test.ts",
    "release": "npm run build && npm test",
    "prepublishOnly": "bun run build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.144"
  },
  "dependencies": {
    "@slack/web-api": "^8.2.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ]
