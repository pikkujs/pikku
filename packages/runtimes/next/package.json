{
  "name": "@pikku/next",
  "version": "0.12.11",
  "description": "Next.js runtime for Pikku — SSR, route handlers, server actions and Better Auth integration",
  "license": "MIT",
  "author": "yasser.fadl@gmail.com",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "tsc": "tsc",
    "ncu": "npx npm-check-updates",
