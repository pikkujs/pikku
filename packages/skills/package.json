{
  "name": "@pikku/skills",
  "version": "0.12.58",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/skills"
  },
  "description": "The Pikku agent skills — the instruction set coding agents read to build, wire and deploy Pikku projects",
  "author": "yasser.fadl@gmail.com",
  "license": "MIT",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "embed": "bun run scripts/embed.ts",
    "tsc": "bun run embed && tsc",
    "build": "bun run clean && bun run embed && tsc -b",
    "ncu": "npx npm-check-updates",
    "test": "bash run-tests.sh",
    "test:watch": "bash run-tests.sh --watch",
    "test:coverage": "bash run-tests.sh --coverage",
    "prepublishOnly": "bun run build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "!dist/**/*.tsbuildinfo"
  ],
  "devDependencies": {
    "@types/node": "^26.6.5",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
