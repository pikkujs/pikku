{
  "name": "@pikku/knowledge",
  "version": "0.12.3",
  "description": "The Open Knowledge Format app-project profile — read, validate and index a project's knowledge/ notes",
  "author": "yasser.fadl@gmail.com",
  "license": "MIT",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "tsc": "tsc",
    "build": "tsc -b",
    "ncu": "npx npm-check-updates",
    "test": "bash run-tests.sh",
    "test:watch": "bash run-tests.sh --watch",
    "test:coverage": "bash run-tests.sh --coverage",
    "prepublishOnly": "yarn build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.11.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
