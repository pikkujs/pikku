{
  "name": "@pikku/db-migrator",
  "version": "0.12.1",
  "description": "The SQL migration applier shared by the Pikku CLI and the standalone runtime",
  "author": "yasser.fadl@gmail.com",
  "license": "MIT",
  "module": "dist/src/index.js",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
