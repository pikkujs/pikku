{
  "name": "@pikku/azure-functions",
  "version": "0.12.9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/runtimes/azure-functions"
  },
  "description": "Azure Functions runtime for Pikku — HTTP, timer and storage-queue handlers",
  "license": "MIT",
  "author": "yasser.fadl@gmail.com",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "tsc": "tsc && tsc -p tsconfig.type-tests.json",
    "ncu": "npx npm-check-updates",
    "build": "bun run clean && tsc -b",
    "release": "npm run build && npm test",
    "test": "bash run-tests.sh",
    "test:watch": "bash run-tests.sh --watch",
    "test:coverage": "bash run-tests.sh --coverage",
    "prepublishOnly": "bun run build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.108"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@azure/functions": "4.16.5",
    "@azure/storage-queue": "^12.32.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ]
}
