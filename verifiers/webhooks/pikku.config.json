{
  "$schema": "https://raw.githubusercontent.com/pikkujs/pikku/refs/heads/main/packages/cli/cli.schema.json",
  "srcDirectories": ["./src", "./types"],
  "ignoreFiles": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/node_modules/**",
    "**/dist/**",
    "**/dev-registration.assert.ts",
    "**/fake-provider.ts",
    "**/file-credential-service.ts",
    "**/webhook-source-switch.assert.ts",
    "**/webhook-source.assert.ts",
    "**/webhook.assert.ts"
  ],
  "outDir": "./.pikku",
  "tsconfig": "./tsconfig.json",
  "scaffold": {
    "webhook": true
  },
  "lint": {
    "enforceContentService": "off"
  }
}
