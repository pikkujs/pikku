node_modules
dist
.vite
.wrangler

# All *.gen.* files are regenerated by `pikku all` — never commit them.
*.gen.ts
*.gen.js
*.gen.json
*.gen.mjs

# Yarn — commit the root lockfile; ignore PnP/cache and generated per-unit lockfiles
.yarn/
.pnp.*
yarn.lock
!/yarn.lock

# Injected/symlinked at sandbox runtime — never commit
vendor/
.pikku-runtime
__fabric_scaffold.vite.config.mjs

# Local dev secrets — generated on first `bun run dev`
.env

# Regenerated on every codegen/dev boot — a committed copy shadows the fresh one
.pikku
.reports

# Agent critique/review scratch — local to a working copy, never part of the template
.impeccable

# Claude Code worktrees — local checkouts, never part of the repo
.claude/worktrees/
