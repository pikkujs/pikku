{
  "name": "@verifier/contrib-kysely",
  "private": true,
  "type": "module",
  "imports": {
    "#pikku/*.js": "./.pikku/*.ts",
    "#pikku/*": "./.pikku/*/index.ts"
  },
  "exports": {
    "./src/*.js": "./src/*.ts",
    "./.pikku/*": "./.pikku/addon/*"
  },
  "files": [
    "src",
    ".pikku"
  ],
  "dependencies": {
    "@pikku/kysely-sqlite": "workspace:*"
  },
  "scripts": {
    "pikku": "pikku all"
  },
