{
  "name": "@pikku/keys",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/keys"
  },
  "description": "The Pikku key service: signing and sealing keys with rotation, custody and revocation",
  "author": "yasser.fadl@gmail.com",
  "license": "MIT",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "tsc": "tsc",
    "ncu": "npx npm-check-updates",
    "build": "bun run clean && tsc -b",
    "release": "npm run build && npm test",
    "test": "bash run-tests.sh",
    "test:watch": "bash run-tests.sh --watch",
    "test:coverage": "bash run-tests.sh --coverage",
    "prepublishOnly": "bun run build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.159"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./file": {
      "types": "./dist/file/index.d.ts",
      "import": "./dist/file/index.js",
      "default": "./dist/file/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ]
}
