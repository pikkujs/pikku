{
  "$schema": "https://raw.githubusercontent.com/pikkujs/pikku/refs/heads/main/packages/cli/cli.schema.json",
  "srcDirectories": ["./src", "./types"],
  "ignoreFiles": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/node_modules/**",
    "**/dist/**",
    "**/check-lifecycle.ts",
    "**/check-remote-local.ts"
  ],
  "outDir": "./.pikku",
  "tsconfig": "./tsconfig.json",
  "lint": {
    "enforceContentService": "off"
  }
}
