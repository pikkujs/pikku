{
  "name": "@pikku/mantine",
  "version": "0.12.16",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/frontend/mantine"
  },
  "description": "Mantine components with i18n-tightened types for Pikku",
  "author": "yasser.fadl@gmail.com",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./core": {
      "import": "./dist/esm/core/index.js",
      "require": "./dist/cjs/core/index.js"
    },
    "./theme": {
      "import": "./dist/esm/theme/index.js",
      "require": "./dist/cjs/theme/index.js"
    },
    "./dev": {
      "import": "./dist/esm/dev/index.js",
      "require": "./dist/cjs/dev/index.js"
    },
    "./theme-spec": {
      "import": "./dist/esm/theme-spec/index.js",
      "require": "./dist/cjs/theme-spec/index.js"
    },
    "./component-meta": {
      "import": "./dist/esm/component-meta/index.js",
      "require": "./dist/cjs/component-meta/index.js"
    },
    "./blocks": {
      "import": "./dist/esm/blocks/index.js",
      "require": "./dist/cjs/blocks/index.js"
    }
  },
  "scripts": {
    "tsc": "tsc",
    "test": "tsc -p tsconfig.test-d.json && node --test src/theme/theme-contract.test.ts && tsx --test src/core/original.test.ts src/core/statics.test.ts src/component-meta/component-meta.test.ts src/blocks/blocks.test.ts",
    "build:esm": "tsc -b && echo '{\"type\": \"module\"}' > dist/esm/package.json",
    "build:cjs": "tsc6 -b tsconfig.cjs.json && echo '{\"type\": \"commonjs\"}' > dist/cjs/package.json",
    "build": "bun run build:esm && bun run build:cjs",
    "prepublishOnly": "bun run build",
    "generate:component-meta": "tsx scripts/generate-component-meta.ts",
    "generate:blocks": "tsx scripts/generate-blocks.ts"
  },
  "peerDependencies": {
    "@mantine/core": "^9.2.1",
    "@mantine/hooks": "^9.2.1",
    "@pikku/react": "^0.12.13",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@pikku/react": "workspace:^",
    "@types/react": "^19",
    "react": "^19",
    "react-dom": "^19",
    "tsx": "^4.23.12"
  },
  "dependencies": {
    "@mantine/colors-generator": "^9.2.1",
    "chroma-js": "^3.1.2"
  }
}
