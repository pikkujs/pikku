{
  "name": "@pikku/inspector-go",
  "version": "0.12.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/inspector-go"
  },
  "description": "Go inspector engine for Pikku — runs analysis in the pikku-inspect binary and finalizes with @pikku/inspector",
  "author": "yasser.fadl@gmail.com",
  "license": "BUSL-1.1",
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol/*.json": "./protocol/*.json"
  },
  "files": [
    "dist",
    "protocol",
    "LICENSE"
  ],
  "scripts": {
    "tsc": "tsc",
    "build": "tsc -b && node scripts/build-go.mjs",
    "build:go": "go build -o bin/pikku-inspect ./cmd/pikku-inspect",
    "parity": "bun parity/parity.ts",
    "ncu": "npx npm-check-updates",
    "test": "bash run-tests.sh",
    "test:watch": "bash run-tests.sh --watch",
    "test:coverage": "bash run-tests.sh --coverage",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@pikku/inspector": "^0.12.106"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tinyglobby": "^0.2.17"
  },
  "engines": {
    "node": ">=24"
  }
}
