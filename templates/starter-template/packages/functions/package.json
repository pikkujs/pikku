{
  "name": "@project/functions",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#pikku/*.js": "./.pikku/*.ts",
    "#pikku/*": "./.pikku/*/index.ts"
  },
  "scripts": {
    "//tsc": "No tsconfig of its own: the root tsconfig.json is the backend's, and it is found by directory lookup from here — which is also how `fabric verify` runs it. Without this script `bun run --filter '*' tsc` matches on script NAME and silently skips the whole backend.",
    "tsc": "tsc --noEmit",
    "db:types": "pikku db types"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.81",
    "@ai-sdk/openai-compatible": "^3.0.59",
    "@pikku/addon-admin": "^0.12.12",
    "@pikku/addon-console": "^0.12.59",
    "@pikku/ai-vercel": "^0.12.15",
    "@pikku/better-auth": "^0.12.55",
    "@pikku/cloudflare": "^0.12.29",
    "@pikku/core": "^0.12.140",
    "@pikku/kysely": "^0.13.36",
    "@pikku/schema-cfworker": "^0.12.8",
    "@standard-schema/spec": "^1.1.0",
    "ai": "^7.0.122",
    "better-auth": "^1.7.6",
    "kysely": "^0.29.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@pikku/playwright": "^0.12.86",
    "@playwright/test": "^1.50.0",
    "@types/node": "^24",
    "typescript": "^6.0.3"
  }
}
