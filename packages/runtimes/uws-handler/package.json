    "test:watch": "bash run-tests.sh --watch",
    "test:coverage": "bash run-tests.sh --coverage",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.108",
    "uWebSockets.js": "*"
  },
  "peerDependenciesMeta": {
    "uWebSockets.js": {
      "optional": true
    }
  },
  "dependencies": {
    "cookie": "^2.0.1",
    "picoquery": "^2.5.0"
