{
  "$schema": "https://raw.githubusercontent.com/pikkujs/pikku/refs/heads/main/packages/cli/cli.schema.json",
  "rootDir": "../functions",
  "tsconfig": "../functions/tsconfig.json",
  "srcDirectories": ["./src", "./types"],
  "schema": {
    "supportsImportAttributes": true
  },
  "forceRequiredServices": ["todoStore"],
  "backends": {
    "app": {
      "filter": {}
    }
  },
  "deploy": {
    "provider": "cloudflare",
    "serverlessIncompatible": [
      "metaService",
      "stateDiffService",
      "codeEditService"
    ]
  },
  "scaffold": {
    "rpc": true,
    "agent": true,
    "analytics": {
      "originLock": false
    },
    "workflow": true,
    "console": true,
    "events": true,
    "meshRpc": true,
    "webhook": true,
    "pikkuDir": "pikku"
  },
  "cli": {
    "entrypoints": {
      "todo-cli": [
        "client/cli-local.gen.ts",
        {
          "type": "channel",
          "wirePath": "src/wirings/cli-channel.gen.ts",
          "path": "client/cli-client.gen.ts"
        }
      ]
    }
  },
  "clientFiles": {
    "nextBackendFile": "./pikku-nextjs.gen.ts"
  }
}
