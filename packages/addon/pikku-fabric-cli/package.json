{
  "name": "@pikku/addon-fabric-cli",
  "version": "0.0.0",
  "private": true,
  "description": "The pikku fabric command group, contributed to the pikku CLI as an addon",
  "type": "module",
  "imports": {
    "#pikku/*.js": "./dist/.pikku/*.js",
    "#pikku/*": [
      "./dist/.pikku/*/index.js",
      "./dist/.pikku/*"
    ]
  },
  "exports": {
    "./contracts": {
      "types": "./dist/src/contracts.d.ts",
      "import": "./dist/src/contracts.js"
    },
    "./.pikku/*": "./dist/.pikku/addon/*",
    "./.pikku/pikku-metadata.gen.json": "./dist/.pikku/addon/pikku-metadata.gen.json",
    "./.pikku/rpc/pikku-rpc-wirings-map.internal.gen.js": {
      "types": "./dist/.pikku/addon/rpc/pikku-rpc-wirings-map.internal.gen.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pikku all",
    "build": "tsc && pikku dist",
    "pikku": "pikku all"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.139",
    "zod": "^4"
  },
  "dependencies": {
    "@pikku/fetch": "workspace:*",
    "chalk": "^6.0.0"
  },
  "devDependencies": {
    "@pikku/cli": "workspace:*",
    "@pikku/core": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "typescript": "^6.0.3",
    "zod": "^4"
  },
  "license": "MIT"
}
