{
  "name": "@pikku/studio-project",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prebuild": "cd packages/functions && bunx --bun pikku all",
    "build": "bun run --filter '*' --if-present build",
    "dev": "bun scripts/dev.mjs",
    "tsc": "bun run --filter '*' tsc",
    "lint": "oxlint apps packages",
    "format": "oxfmt apps packages",
    "format:check": "oxfmt --check apps packages"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.81",
    "@ai-sdk/openai-compatible": "^3.0.59",
    "@pikku/addon-admin": "workspace:*",
    "@pikku/addon-console": "workspace:*",
    "@pikku/ai-vercel": "workspace:*",
    "@pikku/assistant-ui": "workspace:*",
    "@pikku/better-auth": "workspace:*",
    "@pikku/bun-server": "workspace:*",
    "@pikku/core": "workspace:*",
    "@pikku/fetch": "workspace:*",
    "@pikku/kysely": "workspace:*",
    "@pikku/kysely-bun-sqlite": "workspace:*",
    "@pikku/kysely-node-sqlite": "workspace:*",
    "@pikku/kysely-sqlite": "workspace:*",
    "@pikku/mantine": "workspace:*",
    "@pikku/react": "workspace:*",
    "@pikku/schedule": "workspace:*",
    "@pikku/schema-cfworker": "workspace:*",
    "ai": "^7.0.122",
    "better-auth": "^1.7.6",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@pikku/cli": "workspace:*",
    "@pikku/deploy-standalone": "workspace:*",
    "@types/node": "^24",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.78.0",
    "typescript": "^6.0.3"
  }
