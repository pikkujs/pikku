{
  "name": "@pikku/deploy-serverless",
  "version": "0.12.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/deploy/deploy-serverless"
  },
  "description": "Serverless Framework deploy adapter for Pikku — generates serverless.yml and Lambda entry points",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun run clean && tsc -b",
    "tsc": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "license": "MIT",
  "dependencies": {
    "@pikku/deploy": "^0.12.16"
  }
}
