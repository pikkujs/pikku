{
  "name": "@pikku/verifiers-addon",
  "type": "module",
  "private": true,
  "description": "Pikku addon verifiers package",
  "imports": {
    "#pikku/*.js": "./.pikku/*.ts",
    "#pikku/*": "./.pikku/*/index.ts"
  },
  "dependencies": {
    "@pikku/core": "workspace:*",
    "@pikku/fetch": "workspace:*",
    "@pikku/templates-function-addon": "workspace:*",
    "@pikku/websocket": "workspace:*"
  },
  "devDependencies": {
    "@pikku/cli": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^24",
    "tsx": "^4.23.12",
    "zod": "^4"
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "test": "pikku && tsc --noEmit && npx tsx src/contracts.assert.ts",
    "ncu": "npx npm-check-updates",
    "ncu:pikku": "npx npm-check-updates -f '/@pikku/.*/'"
  }
}
