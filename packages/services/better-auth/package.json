{
  "name": "@pikku/better-auth",
  "version": "0.12.56",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/services/better-auth"
  },
  "description": "Better Auth integration for Pikku — auth handler, sessions and scope resolution",
  "author": "yasser.fadl@gmail.com",
  "license": "MIT",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "tsc": "tsc && tsc -p tsconfig.tests.json",
    "ncu": "npx npm-check-updates",
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -b",
    "test": "bash run-tests.sh",
    "test:watch": "bash run-tests.sh --watch",
    "test:coverage": "bash run-tests.sh --coverage",
    "release": "npm run build && npm test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@pikku/jose": "^0.12.9"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.142",
    "better-auth": "^1.7.5",
    "zod": "^4"
  },
  "devDependencies": {
    "@better-auth/api-key": "^1.7.10",
    "@better-auth/core": "^1.7.10",
    "@better-auth/utils": "0.5.0",
    "@better-fetch/fetch": "1.3.2",
    "better-auth": "^1.7.10",
    "better-call": "1.4.2",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "nanostores": "^1.5.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    },
    "./package.json": "./package.json"
  }
}
