{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks"],
  "env": {
    "browser": true,
    "es2022": true
  },
  "rules": {},
  "ignorePatterns": [
    "**/*.gen.ts",
    "**/*.gen.tsx",
    "**/.pikku/**",
    "**/.deploy/**",
    "**/node_modules/**",
    "**/next-env.d.ts"
  ]
}
