{
  "name": "@verifier/log-addon",
  "private": true,
  "type": "module",
  "exports": {
    "./contributors": {
      "types": "./src/contributors.ts",
      "import": "./src/contributors.ts"
    },
    "./log-source": {
      "types": "./src/log-source.ts",
      "import": "./src/log-source.ts"
    },
    "./.pikku/pikku-bootstrap.gen.js": {
      "types": "./stubs/bootstrap.ts",
      "import": "./stubs/bootstrap.ts"
    },
    "./.pikku/workflow/pikku-workflow-map.gen.d.js": {
      "types": "./stubs/workflow-map.ts",
      "import": "./stubs/workflow-map.ts"
    },
    "./.pikku/rpc/pikku-rpc-wirings-map.internal.gen.js": {
      "types": "./stubs/rpc-map.ts",
      "import": "./stubs/rpc-map.ts"
    },
    "./.pikku/agent/pikku-agent-map.gen.d.js": {
      "types": "./stubs/agent-map.ts",
      "import": "./stubs/agent-map.ts"
    }
  },
  "pikku": {
    "contributors": [
      {
        "module": "@verifier/log-addon/contributors",
        "export": "logSources"
      }
    ]
  },
  "description": "A contributors-only addon: no functions, so stubs stand in for the generated maps a built addon publishes"
}
