{
  "tools": [
    {
      "name": "listIssuesTool",
      "description": "List issues in an organisation you belong to, optionally filtered by status",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "orgId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "done",
              "closed",
              "open",
              "in_progress"
            ]
          },
          "limit": {
            "type": "number"
          }
        },
        "required": [
          "orgId"
        ],
        "additionalProperties": false,
        "definitions": {}
      },
      "returns": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "array",
        "items": {
          "$ref": "#/definitions/MCPToolMessage"
        },
        "definitions": {
          "MCPToolMessage": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "text"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "image"
                  },
                  "data": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "data"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      }
    },
    {
      "name": "closeIssueTool",
      "description": "Close an issue, or mark it done",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "issueId": {
            "type": "string"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "done",
              "closed"
            ]
          }
        },
        "required": [
          "issueId"
        ],
        "additionalProperties": false,
        "definitions": {}
      },
      "returns": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "array",
        "items": {
          "$ref": "#/definitions/MCPToolMessage"
        },
        "definitions": {
          "MCPToolMessage": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "text"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "image"
                  },
                  "data": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "data"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      }
    }
  ],
  "resources": [],
  "prompts": []
}