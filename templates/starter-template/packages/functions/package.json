{
  "name": "@project/functions",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#pikku/*.js": "./.pikku/*.ts",
    "#pikku/*": "./.pikku/*/index.ts"
  },
  "scripts": {
    "//tsc": "No tsconfig of its own: the root tsconfig.json is the backend's, and it is found by directory lookup from here — which is also how `cloud verify` runs it. Without this script `bun run --filter '*' tsc` matches on script NAME and silently skips the whole backend.",
    "tsc": "tsc --noEmit",
    "db:types": "pikku db types"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.96",
    "@ai-sdk/openai-compatible": "^3.0.71",
    "@pikku/addon-admin": "^0.12.14",
    "@pikku/addon-console": "^0.12.64",
    "@pikku/ai-vercel": "^0.12.16",
    "@pikku/better-auth": "^0.12.58",
    "@pikku/cloudflare": "^0.12.30",
    "@pikku/core": "^0.12.144",
    "@pikku/kysely": "^0.13.39",
    "@pikku/schema-cfworker": "^0.12.9",
    "@standard-schema/spec": "^1.1.0",
    "ai": "^7.0.143",
    "better-auth": "^1.7.10",
    "kysely": "^0.29.6",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pikku/playwright": "^0.12.89",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26",
    "typescript": "^6.0.3"
  }
}
