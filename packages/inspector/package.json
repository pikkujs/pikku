{
  "name": "@pikku/inspector",
  "version": "0.12.108",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/inspector"
  },
  "description": "TypeScript inspector for Pikku — discovers functions and wirings to drive code generation",
  "author": "yasser.fadl@gmail.com",
  "license": "BUSL-1.1",
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lite": {
      "types": "./dist/lite.d.ts",
      "import": "./dist/lite.js",
      "default": "./dist/lite.js"
    },
    "./schema-generator": {
      "types": "./dist/schema-generator.d.ts",
      "import": "./dist/schema-generator.js",
      "default": "./dist/schema-generator.js"
    },
    "./finalize": {
      "types": "./dist/finalize.d.ts",
      "import": "./dist/finalize.js",
      "default": "./dist/finalize.js"
    },
    "./surface": {
      "types": "./dist/surface/collect-surface.d.ts",
      "import": "./dist/surface/collect-surface.js",
      "default": "./dist/surface/collect-surface.js"
    },
    "./workflow-graph": {
      "types": "./dist/utils/workflow/graph/index.d.ts",
      "import": "./dist/utils/workflow/graph/index.js",
      "default": "./dist/utils/workflow/graph/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "tsc": "tsc",
    "build": "bun run clean && tsc -b",
    "ncu": "npx npm-check-updates -x '/.*glob.*/'",
    "release": "bun run build && npm test",
    "test": "bash run-tests.sh",
    "test:watch": "bash run-tests.sh --watch",
    "test:coverage": "bash run-tests.sh --coverage",
    "prepublishOnly": "bun run build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@openapi-contrib/json-schema-to-openapi-schema": "^4.3.4",
    "openapi-types": "^12.1.3",
    "path-to-regexp": "^8.4.2",
    "ts-json-schema-generator": "2.9.1-next.18",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.144"
  },
  "devDependencies": {
    "@pikku/core": "^0.12.144",
    "@types/node": "^26.6.5"
  },
  "engines": {
    "node": ">=24"
  }
}
