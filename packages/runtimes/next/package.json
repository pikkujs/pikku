    "next": "^15",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "cookie": "^2.0.1",
    "eventemitter3": "^5.0.4",
    "path-to-regexp": "^8.4.2"
  },
  "devDependencies": {
    "@pikku/better-auth": "^0.12.40",
    "@pikku/core": "^0.12.108",
    "@types/react": "^19",
    "better-auth": "^1.6.29",
    "next": "15.5.23",
    "react": "^19",
    "react-dom": "^19"
  },
  "engines": {
    "node": ">=24"
  }
