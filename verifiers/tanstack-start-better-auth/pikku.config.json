{
  "$schema": "https://raw.githubusercontent.com/pikkujs/pikku/refs/heads/main/packages/cli/cli.schema.json",
  "srcDirectories": ["./src", "./types"],
  "ignoreFiles": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/node_modules/**",
    "**/dist/**",
    "**/start.ts"
  ],
  "outDir": "./.pikku",
  "tsconfig": "./tsconfig.json",
  "clientFiles": {
    "fetchFile": "./src/lib/pikku-fetch.gen.ts",
    "rpcWiringsFile": "./src/lib/pikku-rpc.gen.ts",
    "tanstackStartFile": "./src/lib/pikku-start.gen.ts"
  },
  "schema": {
    "supportsImportAttributes": true
  }
}
