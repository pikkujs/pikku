{
  "name": "@pikku/addon-changes-cli",
  "version": "0.12.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/addon/pikku-changes-cli"
  },
  "description": "The pikku changes command group, contributed to the pikku CLI as an addon",
  "type": "module",
  "imports": {
    "#pikku/*.js": "./dist/.pikku/*.js",
    "#pikku/*": [
      "./dist/.pikku/*/index.js",
      "./dist/.pikku/*"
    ]
  },
  "exports": {
    "./contracts": {
      "types": "./dist/src/contracts.d.ts",
      "import": "./dist/src/contracts.js"
    },
    "./renderers": {
      "types": "./dist/src/renderers.d.ts",
      "import": "./dist/src/renderers.js"
    },
    "./types": {
      "types": "./dist/src/lib/types.d.ts",
      "import": "./dist/src/lib/types.js"
    },
    "./backend": {
      "types": "./dist/src/backend.d.ts",
      "import": "./dist/src/backend.js"
    },
    "./.pikku/*": "./dist/.pikku/addon/*",
    "./.pikku/pikku-metadata.gen.json": "./dist/.pikku/addon/pikku-metadata.gen.json",
    "./.pikku/rpc/pikku-rpc-wirings-map.internal.gen.js": {
      "types": "./dist/.pikku/addon/rpc/pikku-rpc-wirings-map.internal.gen.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pikku all",
    "build": "tsc && pikku dist",
    "pikku": "pikku all",
    "test": "bun test --parallel src"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.148",
    "zod": "^4",
    "@pikku/cli": "^0.12.198"
  },
  "dependencies": {
    "@pikku/knowledge": "^0.12.21"
  },
  "devDependencies": {
    "@pikku/cli": "workspace:*",
    "@pikku/core": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "zod": "^4"
  },
  "license": "MIT"
}
