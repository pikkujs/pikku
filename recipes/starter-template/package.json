{
  "name": "@project/root",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "design/*",
    "!apps/_app_template_"
  ],
  "scripts": {
    "prebuild": "cd packages/functions && bunx --bun pikku all",
    "build": "bun run --filter '*' --if-present build",
    "dev": "bun scripts/dev.mjs",
    "tsc": "bun run --filter '*' tsc",
    "lint": "oxlint apps packages",
    "format": "oxfmt apps packages",
    "format:check": "oxfmt --check apps packages"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.96",
    "@ai-sdk/openai-compatible": "^3.0.71",
    "@pikku/addon-admin": "^0.12.15",
    "@pikku/addon-console": "^0.12.65",
    "@pikku/ai-vercel": "^0.12.16",
    "@pikku/assistant-ui": "^0.12.14",
    "@pikku/better-auth": "^0.12.59",
    "@pikku/bun-server": "^0.12.15",
    "@pikku/cloudflare": "^0.12.31",
    "@pikku/core": "0.12.147",
    "@pikku/fetch": "0.12.13",
    "@pikku/kysely": "0.13.40",
    "@pikku/kysely-bun-sqlite": "^0.12.11",
    "@pikku/kysely-node-sqlite": "^0.12.10",
    "@pikku/kysely-sqlite": "^0.12.18",
    "@pikku/react": "^0.12.17",
    "@pikku/schedule": "^0.12.11",
    "@pikku/schema-cfworker": "^0.12.9",
    "ai": "^7.0.143",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@pikku/cli": "0.12.197",
    "@pikku/deploy-standalone": "^0.12.28",
    "@types/node": "^26",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@pikku/cli": "0.12.197",
    "@pikku/core": "0.12.147",
    "@pikku/deploy": "0.12.17",
    "@pikku/fetch": "0.12.13",
    "@pikku/knowledge": "0.12.21",
    "@pikku/kysely": "0.13.40",
    "@pikku/ws": "0.12.11",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.3"
}
