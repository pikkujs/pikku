{
  "name": "@pikku/next",
  "version": "0.12.13",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/runtimes/next"
  },
  "description": "Next.js runtime for Pikku — SSR, route handlers, server actions and Better Auth integration",
  "license": "MIT",
  "author": "yasser.fadl@gmail.com",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "tsc": "tsc",
    "ncu": "npx npm-check-updates",
    "build": "bun run clean && tsc -b",
    "release": "npm run build && npm test",
    "test": "bash run-tests.sh",
    "test:watch": "bash run-tests.sh --watch",
    "test:coverage": "bash run-tests.sh --coverage",
    "prepublishOnly": "bun run build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "exports": {
    ".": "./dist/index.js",
    "./pikku-next-request": "./dist/pikku-next-request.js",
    "./pikku-session": "./dist/pikku-session.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "peerDependencies": {
    "@pikku/better-auth": "^0.12.57",
    "@pikku/core": "^0.12.144",
    "better-auth": "^1.7.5",
    "next": "^15 || ^16",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "cookie": "^2.0.1",
    "eventemitter3": "^5.0.4",
    "path-to-regexp": "^8.4.2"
  },
  "devDependencies": {
    "@pikku/better-auth": "^0.12.57",
    "@pikku/core": "^0.12.144",
    "@types/react": "^19",
    "better-auth": "^1.7.10",
    "next": "16.4.2",
    "react": "^19",
    "react-dom": "^19"
  },
  "engines": {
    "node": ">=24"
  }
}
