{
  "name": "@pikku/cli",
  "version": "0.12.191",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/cli"
  },
  "description": "Pikku CLI — code generation, dev server, migrations and deployment",
  "author": "yasser.fadl@gmail.com",
  "license": "BUSL-1.1",
  "imports": {
    "#pikku/*.js": "./dist/.pikku/*.js",
    "#pikku/*": "./dist/.pikku/*/index.js"
  },
  "bin": {
    "pikku": "dist/bin/pikku.js"
  },
  "type": "module",
  "main": "dist/bin/pikku.js",
  "module": "dist/bin/pikku.js",
  "scripts": {
    "embed": "node scripts/embed-examples.mjs",
    "tsc": "bun run embed && tsc && tsc -p tsconfig.type-tests.json",
    "schema": "ts-json-schema-generator -o cli.schema.json --path 'src/utils/pikku-cli-config.ts' --type 'PikkuCLIConfig'",
    "build": "bash ./build.sh",
    "ncu": "npx npm-check-updates -x '/.*glob.*/'",
    "release": "bun run build && npm test",
    "test": "bash run-tests.sh",
    "test:watch": "bash run-tests.sh --watch",
    "test:coverage": "bash run-tests.sh --coverage",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.96",
    "@ai-sdk/openai-compatible": "^3.0.71",
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-pgvector": "0.0.11",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@openapi-contrib/json-schema-to-openapi-schema": "^4.3.4",
    "@pikku/ai-vercel": "^0.12.15",
    "@pikku/better-auth": "^0.12.56",
    "@pikku/bun-server": "^0.12.14",
    "@pikku/code-edit": "^0.12.7",
    "@pikku/deploy": "^0.12.15",
    "@pikku/deploy-cloudflare": "^0.12.21",
    "@pikku/deploy-standalone": "^0.12.26",
    "@pikku/fetch": "^0.12.12",
    "@pikku/inspector": "^0.12.106",
    "@pikku/knowledge": "^0.12.20",
    "@pikku/kysely": "^0.13.38",
    "@pikku/migrator-sql": "^0.12.8",
    "@pikku/n8n-import": "^0.0.8",
    "@pikku/node-http-server": "^0.12.20",
    "@pikku/openapi-parser": "^0.12.23",
    "@pikku/schedule": "^0.12.10",
    "@pikku/skills": "^0.12.58",
    "@pikku/websocket": "^0.12.5",
    "@types/cookie": "^1.0.0",
    "@types/json-schema": "^7.0.15",
    "ai": "^7.0.143",
    "chalk": "^6.0.1",
    "chokidar": "^5.0.0",
    "esbuild": "~0.28.2",
    "giget": "^3.3.1",
    "istanbul-lib-instrument": "^6.0.3",
    "kysely": "^0.29.6",
    "mysql2": "^3.24.6",
    "open": "^11.0.4",
    "openapi-types": "^12.1.3",
    "path-to-regexp": "^8.4.2",
    "pg": "^8.23.1",
    "semver": "^7.8.5",
    "sqlite-vec": "0.1.9",
    "tinyglobby": "^0.2.17",
    "ts-json-schema-generator": "2.9.1-next.18",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.143",
    "@pikku/playwright": "^0.12.88",
    "@pikku/ws": "^0.12.10",
    "better-auth": "^1.7.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@pikku/addon-changes-cli": "workspace:*",
    "@pikku/addon-cloud-cli": "workspace:*",
    "@pikku/core": "^0.12.143",
    "@pikku/playwright": "^0.12.88",
    "@pikku/ws": "^0.12.10",
    "@playwright/test": "^1.64.1",
    "@standard-schema/spec": "^1.1.0",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8",
    "ws": "^8.22.0"
  },
  "files": [
    "dist",
    "cli.schema.json",
    "surface.json",
    "snippets.json",
    "snippets-meta.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./dist/bin/pikku.js",
    "./validate": "./dist/src/functions/validate/validate-registry.js",
    "./server/spawn-dev-server": "./dist/src/server/spawn-dev-server.js",
    "./server/server-ready": "./dist/src/server/server-ready.js",
    "./utils/virtual-user-signer": "./dist/src/utils/virtual-user-signer.js",
    "./surface.json": "./surface.json",
    "./addon-support/validate": {
      "types": "./dist/src/addon-support-validate.d.ts",
      "import": "./dist/src/addon-support-validate.js",
      "default": "./dist/src/addon-support-validate.js"
    },
    "./addon-support": {
      "types": "./dist/src/addon-support.d.ts",
      "import": "./dist/src/addon-support.js",
      "default": "./dist/src/addon-support.js"
    },
    "./cloud-client": {
      "types": "./dist/src/cloud-client.d.ts",
      "import": "./dist/src/cloud-client.js",
      "default": "./dist/src/cloud-client.js"
    }
  },
  "peerDependenciesMeta": {
    "@pikku/playwright": {
      "optional": true
    },
    "@pikku/ws": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  }
}
