{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pikku E2E",
  "version": "0.1.0",
  "identifier": "dev.pikku.e2e",
  "build": {
    "frontendDist": "../dist-native"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pikku E2E",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
