{
  "$schema": "https://raw.githubusercontent.com/pikkujs/pikku/refs/heads/main/packages/cli/cli.schema.json",
  "srcDirectories": ["./src", "./types"],
  "ignoreFiles": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/node_modules/**",
    "**/dist/**",
    "**/distributed/distributed.assert.ts",
    "**/distributed/recorder.ts"
  ],
  "outDir": "./.pikku",
  "tsconfig": "./tsconfig.json",
  "scaffold": {
    "meshRpc": true,
    "workflow": true
  },
  "lint": {
    "enforceContentService": "off"
  }
}
