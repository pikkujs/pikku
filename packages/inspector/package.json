{
  "name": "@pikku/inspector",
  "version": "0.12.114",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/pikku.git",
    "directory": "packages/inspector"
  },
  "description": "The state Pikku's inspection produces \u2014 its types, serialization and the data helpers the CLI and the native inspector share",
  "author": "yasser.fadl@gmail.com",
  "license": "BUSL-1.1",
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./surface": {
      "types": "./dist/surface/types.d.ts",
      "import": "./dist/surface/types.js",
      "default": "./dist/surface/types.js"
    },
    "./workflow-graph": {
      "types": "./dist/utils/workflow/graph/index.d.ts",
      "import": "./dist/utils/workflow/graph/index.js",
      "default": "./dist/utils/workflow/graph/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "tsc": "tsc",
    "build": "bun run clean && tsc -b",
    "ncu": "npx npm-check-updates -x '/.*glob.*/'",
    "release": "bun run build && npm test",
    "test": "bash run-tests.sh",
    "test:watch": "bash run-tests.sh --watch",
    "test:coverage": "bash run-tests.sh --coverage",
    "prepublishOnly": "bun run build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@openapi-contrib/json-schema-to-openapi-schema": "^4.3.4"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.151"
  },
  "devDependencies": {
    "@pikku/core": "^0.12.151",
    "@types/node": "^26.6.5"
  },
  "engines": {
    "node": ">=24"
  }
}
